{
  "name": "openspec_artifact_drain",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "viren@orkes.io",
  "description": "One pass of openspec_plan's artifact-generation drain loop, extracted into its own sub-workflow: Conductor does not support a DO_WHILE nested directly inside another DO_WHILE (confirmed live and in docs \u2014 'Nested Do While tasks are not supported... use a Sub Workflow task inside the Do While task'). Repeatedly calls openspec_status, JQ-selects not-yet-generated-this-pass artifacts whose OpenSpec status is ready, and fans out openspec_generate_artifact sub-workflows for them, until nothing new is selectable.",
  "inputParameters": [
    "repoPath",
    "changeName",
    "goal",
    "feedback",
    "model",
    "maxTurns",
    "maxBudgetUsd",
    "modelProfile",
    "modelPolicy",
    "modelPolicySource",
    "modelPolicySha256",
    "modelsConfig",
    "modelOverrides"
  ],
  "inputTemplate": {
    "feedback": "",
    "model": "",
    "maxTurns": 500,
    "maxBudgetUsd": 50,
    "modelProfile": "",
    "modelPolicy": {},
    "modelPolicySource": "",
    "modelPolicySha256": "",
    "modelsConfig": "",
    "modelOverrides": {}
  },
  "variables": {
    "generatedThisPass": [],
    "readyCount": 0,
    "filesChanged": [],
    "costUsd": 0,
    "tokenUsed": 0
  },
  "tasks": [
    {
      "name": "model_profile_resolve",
      "taskReferenceName": "model_policy",
      "type": "SIMPLE",
      "inputParameters": {
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "repoPath": "${workflow.input.repoPath}"
      }
    },
    {
      "name": "artifact_loop",
      "taskReferenceName": "artifact_loop",
      "type": "DO_WHILE",
      "evaluatorType": "graaljs",
      "loopCondition": "(function(){ return $.artifact_loop['iteration'] < 8 && $.ready_count > 0; })();",
      "inputParameters": {
        "artifact_loop": "${artifact_loop.output}",
        "ready_count": "${workflow.variables.readyCount}"
      },
      "loopOver": [
        {
          "name": "openspec_status",
          "taskReferenceName": "status",
          "type": "SIMPLE",
          "inputParameters": {
            "repoPath": "${workflow.input.repoPath}",
            "changeName": "${workflow.input.changeName}"
          }
        },
        {
          "name": "openspec_select_ready",
          "taskReferenceName": "select_ready",
          "type": "SIMPLE",
          "optional": true,
          "inputParameters": {
            "status": "${status.output}",
            "generated": "${workflow.variables.generatedThisPass}",
            "repoPath": "${workflow.input.repoPath}",
            "changeName": "${workflow.input.changeName}",
            "feedback": "${workflow.input.feedback}",
            "goal": "${workflow.input.goal}",
            "model": "${workflow.input.model}",
            "maxTurns": "${workflow.input.maxTurns}",
            "maxBudgetUsd": "${workflow.input.maxBudgetUsd}",
            "modelProfile": "${workflow.input.modelProfile}",
            "modelPolicy": "${workflow.input.modelPolicy}",
            "modelPolicySource": "${workflow.input.modelPolicySource}",
            "modelPolicySha256": "${workflow.input.modelPolicySha256}",
            "modelsConfig": "${workflow.input.modelsConfig}",
            "modelOverrides": "${workflow.input.modelOverrides}"
          }
        },
        {
          "name": "fan_out_artifacts",
          "taskReferenceName": "fan_out_artifacts",
          "type": "FORK_JOIN_DYNAMIC",
          "dynamicForkTasksParam": "dynamicTasks",
          "dynamicForkTasksInputParamName": "dynamicTasksInput",
          "inputParameters": {
            "dynamicTasks": "${select_ready.output.dynamicTasks}",
            "dynamicTasksInput": "${select_ready.output.dynamicTasksInput}"
          }
        },
        {
          "name": "fan_join_artifacts",
          "taskReferenceName": "fan_join_artifacts",
          "type": "JOIN"
        },
        {
          "name": "openspec_merge_pass_progress",
          "taskReferenceName": "merge_pass_progress",
          "type": "SIMPLE",
          "optional": true,
          "inputParameters": {
            "fanOutput": "${fan_join_artifacts.output}",
            "readyIds": "${select_ready.output.readyIds}",
            "prevGenerated": "${workflow.variables.generatedThisPass}",
            "prevFiles": "${workflow.variables.filesChanged}",
            "prevCost": "${workflow.variables.costUsd}",
            "prevTokens": "${workflow.variables.tokenUsed}"
          }
        },
        {
          "name": "capture_round",
          "taskReferenceName": "capture_round",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "generatedThisPass": "${merge_pass_progress.output.generated}",
            "readyCount": "${select_ready.output.readyCount}",
            "filesChanged": "${merge_pass_progress.output.filesChanged}",
            "costUsd": "${merge_pass_progress.output.costUsd}",
            "tokenUsed": "${merge_pass_progress.output.tokenUsed}"
          }
        }
      ]
    }
  ],
  "outputParameters": {
    "changeName": "${status.output.changeName}",
    "changeDir": "${status.output.changeRoot}",
    "tasksPath": "${status.output.artifactPaths.tasks.resolvedOutputPath}",
    "filesChanged": "${workflow.variables.filesChanged}",
    "costUsd": "${workflow.variables.costUsd}",
    "tokenUsed": "${workflow.variables.tokenUsed}"
  },
  "timeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "inputSchema": {
    "name": "openspec_artifact_drain_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "description": "Absolute path to the git repo containing the OpenSpec change."
        },
        "changeName": {
          "type": "string",
          "description": "OpenSpec change id to drain artifacts for."
        },
        "goal": {
          "type": "string",
          "description": "Change goal/description forwarded to each generated artifact's sub-workflow. Untyped in the underlying openspec_select_ready task schema; typed here as string from its name and pass-through usage as the change's requested-change text."
        },
        "feedback": {
          "type": "string",
          "default": "",
          "description": "Prior review feedback text forwarded to each dynamically-forked openspec_generate_artifact sub-workflow."
        },
        "model": {
          "type": "string",
          "default": "",
          "description": "Model identifier forwarded to each dynamically-forked sub-workflow; empty string defers to the resolved model policy."
        },
        "maxTurns": {
          "type": "integer",
          "default": 500,
          "description": "Max agent turns forwarded to each dynamically-forked sub-workflow."
        },
        "maxBudgetUsd": {
          "type": "number",
          "default": 50,
          "description": "USD budget ceiling forwarded to each dynamically-forked sub-workflow."
        },
        "modelProfile": {
          "type": "string",
          "default": "",
          "description": "Named model-policy profile to select; empty string defers to the policy's default profile."
        },
        "modelPolicy": {
          "type": "object",
          "default": {},
          "description": "Inline model policy document merged on top of the bundled and repository policies."
        },
        "modelPolicySource": {
          "type": "string",
          "default": "",
          "description": "Label recorded for the inline modelPolicy's provenance."
        },
        "modelPolicySha256": {
          "type": "string",
          "default": "",
          "description": "Expected canonical SHA-256 of the inline modelPolicy; resolution fails if it does not match."
        },
        "modelsConfig": {
          "type": "string",
          "default": "",
          "description": "Relative path inside the worktree to a repository model policy file, overriding the default location."
        },
        "modelOverrides": {
          "type": "object",
          "default": {},
          "description": "Per-role/per-artifact overrides merged on top of the selected model profile's roles."
        }
      },
      "required": [
        "repoPath",
        "changeName",
        "goal"
      ]
    }
  },
  "outputSchema": {
    "name": "openspec_artifact_drain_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "changeName": {
          "type": "string",
          "description": "OpenSpec change id this drain pass ran for."
        },
        "changeDir": {
          "type": "string",
          "description": "Absolute path to the change's directory."
        },
        "tasksPath": {
          "type": "string",
          "description": "Resolved output path of the change's 'tasks' artifact. Inferred as string; the underlying artifactPaths map is untyped in the openspec_status task schema."
        },
        "filesChanged": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Deduplicated union of every file changed across all drain passes."
        },
        "costUsd": {
          "type": "number",
          "description": "Cumulative USD cost across all drain passes' artifact-generation sub-workflows."
        },
        "tokenUsed": {
          "type": "number",
          "description": "Cumulative token usage across all drain passes' artifact-generation sub-workflows."
        }
      },
      "required": [
        "changeName",
        "changeDir",
        "tasksPath",
        "filesChanged",
        "costUsd",
        "tokenUsed"
      ]
    }
  },
  "enforceSchema": false
}
