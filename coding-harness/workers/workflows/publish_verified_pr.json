{
  "name": "publish_verified_pr",
  "version": 1,
  "description": "Push one approved, locally verified candidate only when the local branch and remote PR head still match (reconciling a moved remote branch first when they don't), then post the supplied success comment. Completes once the branch is updated -- CI status is left to GitHub's own PR page, not polled here.",
  "schemaVersion": 2,
  "ownerEmail": "viren@orkes.io",
  "inputParameters": [
    "repoPath",
    "repo",
    "headRepo",
    "prNumber",
    "branch",
    "expectedHeadSha",
    "candidateCommit",
    "replyBody",
    "modelProfile",
    "modelPolicy",
    "modelPolicySource",
    "modelPolicySha256",
    "modelsConfig",
    "modelOverrides",
    "reconcileModel",
    "reconcileMaxResolutionAttempts",
    "reconcileMaxBudgetUsd",
    "allowAgentTestPlan",
    "allowAgentAuthoredTests"
  ],
  "inputTemplate": {
    "replyBody": "",
    "modelProfile": "",
    "modelPolicy": {},
    "modelPolicySource": "",
    "modelPolicySha256": "",
    "modelsConfig": "",
    "modelOverrides": {},
    "reconcileModel": "",
    "reconcileMaxResolutionAttempts": 3,
    "reconcileMaxBudgetUsd": 50.0,
    "allowAgentTestPlan": true,
    "allowAgentAuthoredTests": true
  },
  "inputSchema": {
    "name": "publish_verified_pr_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "description": "Absolute path to the local git checkout holding the verified candidate branch."
        },
        "repo": {
          "type": "string",
          "description": "GitHub repository (owner/name or URL) that owns the commit, used to query CI checks after pushing."
        },
        "headRepo": {
          "type": "string",
          "description": "GitHub repository (owner/name or URL) that owns the PR's head branch, used to detect branch drift before pushing."
        },
        "prNumber": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Number of the PR to comment on once CI passes."
        },
        "branch": {
          "type": "string",
          "description": "Local and remote branch name of the verified candidate to push."
        },
        "expectedHeadSha": {
          "type": "string",
          "description": "Remote PR branch tip SHA snapshot taken before edits; the push is refused if the branch has drifted since. May be blank to skip the drift check."
        },
        "candidateCommit": {
          "type": "string",
          "description": "Exact local commit SHA that must still be checked out (in-place guard) and is bound as the push source."
        },
        "replyBody": {
          "type": "string",
          "default": "",
          "description": "Comment body to post on the PR once the pushed commit's CI checks pass."
        },
        "modelProfile": {
          "type": "string",
          "default": "",
          "description": "Named model profile to resolve; empty string defers to the policy's default profile."
        },
        "modelPolicy": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "default": {},
          "description": "Inline model policy document (or JSON string) merged on top of the bundled and repository policies."
        },
        "modelPolicySource": {
          "type": "string",
          "default": "",
          "description": "Provenance label recorded for the inline modelPolicy."
        },
        "modelPolicySha256": {
          "type": "string",
          "default": "",
          "description": "Expected canonical SHA-256 of the inline modelPolicy."
        },
        "modelsConfig": {
          "type": "string",
          "default": "",
          "description": "Relative path (inside the worktree) to a repository model policy file, overriding the default location."
        },
        "modelOverrides": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "default": {},
          "description": "Per-role model overrides (or a JSON string of the same) merged on top of the selected profile."
        },
        "reconcileModel": {
          "type": "string",
          "default": "",
          "description": "Model identifier passed to the branch-drift conflict-resolution agent. Falls back to the agent's default when omitted; only used when the remote branch has drifted."
        },
        "reconcileMaxResolutionAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3,
          "description": "Max agent attempts to resolve a real branch-drift conflict before publication is blocked as branch_drift."
        },
        "reconcileMaxBudgetUsd": {
          "type": "number",
          "default": 50.0,
          "description": "USD budget ceiling for the branch-drift conflict-resolution agent."
        },
        "allowAgentTestPlan": {
          "type": "boolean",
          "default": true,
          "description": "Forwarded to the re-verification test_cycle sub-workflow run after a resolved branch-drift conflict: when true and deterministic discovery is configuration_blocked, lets a coding agent search for and propose an existing test command as a last resort."
        },
        "allowAgentAuthoredTests": {
          "type": "boolean",
          "default": true,
          "description": "Forwarded to the re-verification test_cycle sub-workflow run after a resolved branch-drift conflict: when true and allowAgentTestPlan's search also finds nothing, lets a coding agent author exactly one new test file, accepted only after a red/green check (fails against the pre-candidate baseline, passes against the real candidate change)."
        }
      },
      "required": [
        "repoPath",
        "repo",
        "headRepo",
        "prNumber",
        "branch",
        "expectedHeadSha",
        "candidateCommit"
      ]
    }
  },
  "outputSchema": {
    "name": "publish_verified_pr_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "description": "Candidate branch name that was targeted for publication, echoed from workflow.input.branch."
        },
        "candidateCommit": {
          "type": "string",
          "description": "Candidate commit SHA that was targeted for publication, echoed from workflow.input.candidateCommit."
        },
        "pushed": {
          "type": "boolean",
          "description": "True if the candidate branch was successfully pushed to the remote; false if blocked by branch drift, permission, or policy."
        },
        "pushedHead": {
          "type": "string",
          "description": "Commit SHA that was actually pushed; empty string if the push never happened."
        },
        "publicationState": {
          "type": "string",
          "enum": [
            "pending",
            "published",
            "permission_blocked",
            "policy_blocked",
            "branch_drift",
            "conflict_verification_failed"
          ],
          "description": "Final publication outcome: 'published' once the push succeeded and the success comment was posted (this workflow does not wait for CI -- GitHub's own PR page reports check status independently), 'branch_drift' if the remote head moved before pushing and reconciliation could not produce a trustable commit (no candidate covers it, or a resolved conflict failed re-verification -- see 'conflict_verification_failed' for that specific case), otherwise the specific push block reason."
        },
        "replyUrl": {
          "type": "string",
          "description": "URL of the posted success comment; empty string unless publicationState is 'published'."
        },
        "reconcileState": {
          "type": "string",
          "enum": [
            "",
            "merged",
            "resolved",
            "resolved_but_unverified",
            "conflicted"
          ],
          "description": "Empty when the remote never drifted. 'merged': the remote's new commits did not overlap the candidate's own changes, pushed without re-verification. 'resolved': a real conflict was resolved and re-verified before pushing. 'resolved_but_unverified': a conflict was resolved but re-verification failed, so nothing was pushed. 'conflicted': resolution itself failed, so nothing was pushed."
        },
        "reconcileTokens": {
          "type": "integer",
          "description": "LLM tokens consumed by branch-drift conflict resolution; 0 when the remote never drifted or the merge was clean."
        },
        "reconcileCostUsd": {
          "type": "number",
          "description": "USD cost of branch-drift conflict resolution; 0 when the remote never drifted or the merge was clean."
        }
      },
      "required": [
        "branch",
        "candidateCommit",
        "pushed",
        "pushedHead",
        "publicationState",
        "replyUrl",
        "reconcileState",
        "reconcileTokens",
        "reconcileCostUsd"
      ]
    }
  },
  "variables": {
    "publicationState": "pending",
    "pushed": false,
    "pushedHead": "",
    "replyUrl": "",
    "readyToPush": false,
    "pushExpectedHead": "",
    "reconcileState": "",
    "reconcileTokens": 0,
    "reconcileCostUsd": 0.0
  },
  "tasks": [
    {
      "name": "model_profile_resolve",
      "taskReferenceName": "model_policy",
      "type": "SIMPLE",
      "inputParameters": {
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "repoPath": "${workflow.input.repoPath}"
      }
    },
    {
      "name": "inplace_guard",
      "taskReferenceName": "candidate_guard",
      "type": "SIMPLE",
      "inputParameters": {
        "repoPath": "${workflow.input.repoPath}",
        "branch": "${workflow.input.branch}",
        "expectedHead": "${workflow.input.candidateCommit}"
      }
    },
    {
      "name": "pr_branch_guard",
      "taskReferenceName": "branch_guard",
      "type": "SIMPLE",
      "inputParameters": {
        "repo": "${workflow.input.headRepo}",
        "branch": "${workflow.input.branch}",
        "expectedHeadSha": "${workflow.input.expectedHeadSha}"
      }
    },
    {
      "name": "branch_guard_gate",
      "taskReferenceName": "branch_guard_gate",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "state",
      "inputParameters": {
        "state": "${branch_guard.output.verificationState}"
      },
      "decisionCases": {
        "matched": [
          {
            "name": "capture_ready_to_push",
            "taskReferenceName": "capture_ready_to_push",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "readyToPush": true,
              "pushExpectedHead": "${workflow.input.candidateCommit}"
            }
          }
        ]
      },
      "defaultCase": [
        {
          "name": "reconcile_branch_drift",
          "taskReferenceName": "reconcile",
          "type": "SIMPLE",
          "inputParameters": {
            "repoPath": "${workflow.input.repoPath}",
            "branch": "${workflow.input.branch}",
            "model": "${workflow.input.reconcileModel}",
            "maxResolutionAttempts": "${workflow.input.reconcileMaxResolutionAttempts}",
            "maxBudgetUsd": "${workflow.input.reconcileMaxBudgetUsd}"
          }
        },
        {
          "name": "capture_reconcile_usage",
          "taskReferenceName": "capture_reconcile_usage",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "reconcileTokens": "${reconcile.output.tokenUsed}",
            "reconcileCostUsd": "${reconcile.output.costUsd}"
          }
        },
        {
          "name": "reconcile_gate",
          "taskReferenceName": "reconcile_gate",
          "type": "SWITCH",
          "evaluatorType": "value-param",
          "expression": "state",
          "inputParameters": {
            "state": "${reconcile.output.mergeState}"
          },
          "decisionCases": {
            "merged": [
              {
                "name": "capture_reconciled_merge",
                "taskReferenceName": "capture_reconciled_merge",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "readyToPush": true,
                  "pushExpectedHead": "${reconcile.output.commit}",
                  "reconcileState": "merged"
                }
              }
            ],
            "resolved": [
              {
                "name": "test_cycle",
                "taskReferenceName": "revalidate_reconciled_candidate",
                "type": "SUB_WORKFLOW",
                "subWorkflowParam": {
                  "name": "test_cycle",
                  "version": 1
                },
                "inputParameters": {
                  "repoPath": "${workflow.input.repoPath}",
                  "candidateCommit": "${reconcile.output.commit}",
                  "testMode": "targeted",
                  "allowAgentTestPlan": "${workflow.input.allowAgentTestPlan}",
                  "allowAgentAuthoredTests": "${workflow.input.allowAgentAuthoredTests}",
                  "modelProfile": "${workflow.input.modelProfile}",
                  "modelPolicy": "${workflow.input.modelPolicy}",
                  "modelPolicySource": "${workflow.input.modelPolicySource}",
                  "modelPolicySha256": "${workflow.input.modelPolicySha256}",
                  "modelsConfig": "${workflow.input.modelsConfig}",
                  "modelOverrides": "${workflow.input.modelOverrides}"
                }
              },
              {
                "name": "reconcile_verify_gate",
                "taskReferenceName": "reconcile_verify_gate",
                "type": "SWITCH",
                "evaluatorType": "value-param",
                "expression": "state",
                "inputParameters": {
                  "state": "${revalidate_reconciled_candidate.output.testsPassed}"
                },
                "decisionCases": {
                  "true": [
                    {
                      "name": "capture_reconciled_verified",
                      "taskReferenceName": "capture_reconciled_verified",
                      "type": "SET_VARIABLE",
                      "inputParameters": {
                        "readyToPush": true,
                        "pushExpectedHead": "${reconcile.output.commit}",
                        "reconcileState": "resolved"
                      }
                    }
                  ]
                },
                "defaultCase": [
                  {
                    "name": "capture_reconcile_verification_failed",
                    "taskReferenceName": "capture_reconcile_verification_failed",
                    "type": "SET_VARIABLE",
                    "inputParameters": {
                      "readyToPush": false,
                      "publicationState": "conflict_verification_failed",
                      "reconcileState": "resolved_but_unverified"
                    }
                  }
                ]
              }
            ]
          },
          "defaultCase": [
            {
              "name": "capture_branch_drift",
              "taskReferenceName": "capture_branch_drift",
              "type": "SET_VARIABLE",
              "inputParameters": {
                "readyToPush": false,
                "publicationState": "branch_drift",
                "reconcileState": "conflicted"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "push_ready_gate",
      "taskReferenceName": "push_ready_gate",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "ready",
      "inputParameters": {
        "ready": "${workflow.variables.readyToPush}"
      },
      "decisionCases": {
        "true": [
          {
            "name": "git_push",
            "taskReferenceName": "push",
            "type": "SIMPLE",
            "inputParameters": {
              "repoPath": "${workflow.input.repoPath}",
              "branch": "${workflow.input.branch}",
              "setUpstream": true,
              "expectedHead": "${workflow.variables.pushExpectedHead}"
            }
          },
          {
            "name": "push_result_gate",
            "taskReferenceName": "push_result_gate",
            "type": "SWITCH",
            "evaluatorType": "value-param",
            "expression": "pushed",
            "inputParameters": {
              "pushed": "${push.output.pushed}"
            },
            "decisionCases": {
              "true": [
                {
                  "name": "pr_comment",
                  "taskReferenceName": "reply",
                  "type": "SIMPLE",
                  "inputParameters": {
                    "repoPath": "${workflow.input.repoPath}",
                    "repo": "${workflow.input.repo}",
                    "number": "${workflow.input.prNumber}",
                    "body": "${workflow.input.replyBody}"
                  }
                },
                {
                  "name": "capture_publication_success",
                  "taskReferenceName": "capture_publication_success",
                  "type": "SET_VARIABLE",
                  "inputParameters": {
                    "publicationState": "published",
                    "pushed": true,
                    "pushedHead": "${push.output.head}",
                    "replyUrl": "${reply.output.url}"
                  }
                }
              ]
            },
            "defaultCase": [
              {
                "name": "capture_push_blocked",
                "taskReferenceName": "capture_push_blocked",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "publicationState": "${push.output.publicationState}",
                  "pushed": false
                }
              }
            ]
          }
        ]
      },
      "defaultCase": []
    }
  ],
  "outputParameters": {
    "branch": "${workflow.input.branch}",
    "candidateCommit": "${workflow.input.candidateCommit}",
    "pushed": "${workflow.variables.pushed}",
    "pushedHead": "${workflow.variables.pushedHead}",
    "publicationState": "${workflow.variables.publicationState}",
    "replyUrl": "${workflow.variables.replyUrl}",
    "reconcileState": "${workflow.variables.reconcileState}",
    "reconcileTokens": "${workflow.variables.reconcileTokens}",
    "reconcileCostUsd": "${workflow.variables.reconcileCostUsd}"
  },
  "restartable": true,
  "timeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "enforceSchema": false
}
