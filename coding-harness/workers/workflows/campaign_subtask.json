{
  "updateTime": 1784527268930,
  "name": "campaign_subtask",
  "description": "One resumable feature-campaign DAG task: create an isolated worktree, run a file-scoped coding session, and commit only successful work. Agent exhaustion is returned as data for the parent checkpoint.",
  "version": 1,
  "tasks": [
    {
      "name": "model_profile_resolve",
      "taskReferenceName": "model_policy",
      "type": "SIMPLE",
      "inputParameters": {
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "repoPath": "${workflow.input.repoPath}"
      }
    },
    {
      "name": "worktree_add",
      "taskReferenceName": "campaign_worktree",
      "inputParameters": {
        "name": "campaign-w${workflow.input.wave}-${workflow.input.task.id}",
        "preserveExisting": true,
        "repoPath": "${workflow.input.repoPath}"
      },
      "type": "SIMPLE",
      "decisionCases": {},
      "defaultCase": []
    },
    {
      "name": "coding_agent",
      "taskReferenceName": "campaign_code",
      "inputParameters": {
        "agent": "${workflow.input.agent}",
        "allowedWriteRoots": "${workflow.input.task.files}",
        "contextFiles": [
          "${workflow.input.specContextPath}"
        ],
        "contextPaths": "${workflow.input.contextPaths}",
        "failSoft": true,
        "maxBudgetUsd": "${workflow.input.maxBudgetUsd}",
        "maxTurns": "${workflow.input.maxTurns}",
        "model": "${workflow.input.model}",
        "prompt": "Implement DAG task ${workflow.input.task.id}: ${workflow.input.task.description}\n\nDependencies are already integrated. Acceptance criteria: ${workflow.input.task.acceptanceCriteria}\nPlanned checks: ${workflow.input.task.checks}\nWrite only within: ${workflow.input.task.files}\nCheckpoint feedback: ${workflow.input.feedback}\nRun relevant focused checks, but do not commit or push.",
        "promptContext": {
          "feedback": "${workflow.input.feedback}",
          "files": "${workflow.input.task.files}",
          "subtask": "${workflow.input.task.description}"
        },
        "promptTemplate": "${workflow.input.codePromptTemplate}",
        "promptTemplateSource": "${workflow.input.codePromptTemplateSource}",
        "resumeSessionId": "${workflow.input.resumeSessionId}",
        "templateKey": "code",
        "worktreePath": "${campaign_worktree.output.worktreePath}",
        "modelRole": "code",
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "modelResolution": "${model_policy.output}"
      },
      "type": "SIMPLE",
      "decisionCases": {},
      "defaultCase": []
    },
    {
      "name": "campaign_commit_gate",
      "taskReferenceName": "campaign_commit_gate",
      "inputParameters": {
        "status": "${campaign_code.output.status}"
      },
      "type": "SWITCH",
      "decisionCases": {
        "success": [
          {
            "name": "commit",
            "taskReferenceName": "campaign_commit",
            "inputParameters": {
              "message": "feature campaign: ${workflow.input.task.id}",
              "repoPath": "${campaign_worktree.output.worktreePath}"
            },
            "type": "SIMPLE",
            "decisionCases": {},
            "defaultCase": []
          }
        ]
      },
      "defaultCase": [
        {
          "name": "campaign_no_commit",
          "taskReferenceName": "campaign_no_commit",
          "type": "NOOP",
          "decisionCases": {},
          "defaultCase": []
        }
      ],
      "evaluatorType": "value-param",
      "expression": "status"
    }
  ],
  "inputParameters": [
    "agent",
    "codePromptTemplate",
    "codePromptTemplateSource",
    "feedback",
    "maxBudgetUsd",
    "maxTurns",
    "model",
    "modelOverrides",
    "modelPolicy",
    "modelPolicySha256",
    "modelPolicySource",
    "modelProfile",
    "modelsConfig",
    "repoPath",
    "contextPaths",
    "resumeSessionId",
    "specContextPath",
    "task",
    "wave"
  ],
  "outputParameters": {
    "branch": "${campaign_worktree.output.branch}",
    "costUsd": "${campaign_code.output.costUsd}",
    "error": "${campaign_code.output.error}",
    "filesChanged": "${campaign_code.output.filesChanged}",
    "numTurns": "${campaign_code.output.numTurns}",
    "promptTemplate": "${campaign_code.output.promptTemplate}",
    "retryable": "${campaign_code.output.retryable}",
    "sessionId": "${campaign_code.output.sessionId}",
    "status": "${campaign_code.output.status}",
    "taskId": "${workflow.input.task.id}",
    "tokenUsed": "${campaign_code.output.tokenUsed}",
    "worktreePath": "${campaign_worktree.output.worktreePath}",
    "worktreeResumed": "${campaign_worktree.output.resumed}"
  },
  "schemaVersion": 2,
  "restartable": true,
  "ownerEmail": "viren@orkes.io",
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0,
  "inputTemplate": {
    "agent": "",
    "codePromptTemplate": "",
    "codePromptTemplateSource": "",
    "feedback": "",
    "maxBudgetUsd": 50,
    "maxTurns": 500,
    "model": "",
    "resumeSessionId": "",
    "specContextPath": "",
    "contextPaths": [],
    "modelProfile": "",
    "modelPolicy": {},
    "modelPolicySource": "",
    "modelPolicySha256": "",
    "modelsConfig": "",
    "modelOverrides": {}
  },
  "overwriteTags": false,
  "inputSchema": {
    "name": "campaign_subtask_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "description": "Absolute path to the repository the campaign worktree is created under."
        },
        "wave": {
          "type": "integer",
          "description": "Current campaign wave number; used to name the isolated worktree/branch for this task."
        },
        "task": {
          "type": "object",
          "description": "Normalized DAG task node (from campaign_validate_plan) this subtask executes.",
          "properties": {
            "id": {
              "type": "string",
              "description": "Canonical, Conductor-safe task identifier."
            },
            "description": {
              "type": "string",
              "description": "Task description."
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Canonical IDs of tasks this task depends on."
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Write-root file paths this task is scoped to; used as the agent's allowedWriteRoots."
            },
            "acceptanceCriteria": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Acceptance criteria strings this task must satisfy."
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Named checks planned for this task."
            }
          },
          "required": [
            "id",
            "description",
            "dependsOn",
            "files",
            "acceptanceCriteria",
            "checks"
          ]
        },
        "agent": {
          "type": "string",
          "default": "",
          "description": "Coding agent identifier to run this subtask's session."
        },
        "codePromptTemplate": {
          "type": "string",
          "default": "",
          "description": "Inline prompt template for the coding step."
        },
        "codePromptTemplateSource": {
          "type": "string",
          "default": "",
          "description": "Provenance label for the code prompt template."
        },
        "feedback": {
          "type": "string",
          "default": "",
          "description": "Checkpoint feedback from a prior campaign iteration to fold into this session's prompt."
        },
        "maxBudgetUsd": {
          "type": "number",
          "default": 50,
          "description": "Maximum USD spend allowed for this subtask's coding session."
        },
        "maxTurns": {
          "type": "integer",
          "default": 500,
          "description": "Maximum agent turns allowed for this subtask's coding session."
        },
        "model": {
          "type": "string",
          "default": "",
          "description": "Compatibility override: explicit model id for the coding session."
        },
        "resumeSessionId": {
          "type": "string",
          "default": "",
          "description": "Prior agent session id to resume instead of starting a cold session."
        },
        "specContextPath": {
          "type": "string",
          "default": "",
          "description": "Path to a spec context file added as read-only context for the coding session."
        },
        "contextPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute filesystem paths granted to the coding session as read-only live context references."
        },
        "modelProfile": {
          "type": "string",
          "default": "",
          "description": "Named model profile to select from the merged model policy."
        },
        "modelPolicy": {
          "type": "object",
          "default": {},
          "description": "Inline model policy document merged on top of the bundled and repository policies."
        },
        "modelPolicySource": {
          "type": "string",
          "default": "",
          "description": "Label recorded for the inline modelPolicy's provenance."
        },
        "modelPolicySha256": {
          "type": "string",
          "default": "",
          "description": "Expected canonical SHA-256 of the inline modelPolicy."
        },
        "modelsConfig": {
          "type": "string",
          "default": "",
          "description": "Relative path (inside the worktree) to the repository model policy file."
        },
        "modelOverrides": {
          "type": "object",
          "default": {},
          "description": "Per-role overrides merged on top of the selected profile's roles."
        }
      },
      "required": [
        "repoPath",
        "wave",
        "task"
      ]
    }
  },
  "outputSchema": {
    "name": "campaign_subtask_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "description": "Group branch checked out in the campaign worktree."
        },
        "costUsd": {
          "type": "number",
          "description": "Total USD cost of the coding session."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable error message; only set on a failure/failSoft path (status other than success)."
        },
        "filesChanged": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repository-relative paths the agent changed and that survived scope enforcement."
        },
        "numTurns": {
          "type": "integer",
          "description": "Total number of agent turns taken by the coding session."
        },
        "promptTemplate": {
          "type": "object",
          "description": "Which prompt template source was requested vs. actually resolved for the coding session.",
          "properties": {
            "requestedSource": {
              "type": "string",
              "description": "Caller-supplied promptTemplateSource, or 'auto'."
            },
            "resolvedSource": {
              "type": "string",
              "description": "Actual source the prompt was resolved from."
            },
            "templateKey": {
              "type": "string",
              "description": "Template key that was used, if any."
            },
            "sha256": {
              "type": "string",
              "description": "SHA-256 of the rendered prompt template."
            }
          }
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Only set on a failure/failSoft path: true if the failure can be retried via resumeSessionId."
        },
        "sessionId": {
          "type": "string",
          "description": "Backend session id for this run, usable as resumeSessionId; empty string if unavailable."
        },
        "status": {
          "type": "string",
          "description": "Terminal agent session status, e.g. success, error_max_turns, error_max_budget_usd, policy_denied, invalid_plan."
        },
        "taskId": {
          "type": "string",
          "description": "Echoed id of the DAG task this subtask executed."
        },
        "tokenUsed": {
          "type": "integer",
          "description": "Total tokens consumed by the coding session."
        },
        "worktreePath": {
          "type": "string",
          "description": "Absolute path to the created (or reused) campaign worktree."
        },
        "worktreeResumed": {
          "type": "boolean",
          "description": "True if an existing worktree at that path was reused instead of being recreated."
        }
      },
      "required": [
        "branch",
        "costUsd",
        "error",
        "filesChanged",
        "numTurns",
        "promptTemplate",
        "retryable",
        "sessionId",
        "status",
        "taskId",
        "tokenUsed",
        "worktreePath",
        "worktreeResumed"
      ]
    }
  },
  "enforceSchema": false
}
