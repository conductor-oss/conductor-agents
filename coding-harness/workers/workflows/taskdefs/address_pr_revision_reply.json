{
  "name": "address_pr_revision_reply",
  "description": "Deterministic decision step, replacing a JSON_JQ_TRANSFORM.",
  "retryCount": 1,
  "retryLogic": "FIXED",
  "retryDelaySeconds": 1,
  "timeoutSeconds": 0,
  "responseTimeoutSeconds": 0,
  "pollTimeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "ownerEmail": "viren@orkes.io",
  "inputSchema": {
    "name": "address_pr_revision_reply_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "proposalText": {
          "type": "string",
          "description": "Summary text describing the proposed fix; a placeholder is used when absent."
        },
        "subtasks": {
          "type": "array",
          "description": "Subtasks addressed, rendered as a bulleted '- **id**: description' list.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Subtask identifier."
              },
              "description": {
                "type": "string",
                "description": "Subtask description."
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Verification findings, rendered as a bulleted list."
        }
      }
    }
  },
  "outputSchema": {
    "name": "address_pr_revision_reply_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "reply": {
          "type": "string",
          "description": "Composed Markdown reply body posted after a human-requested approval revision."
        }
      },
      "required": [
        "reply"
      ]
    }
  }
}
