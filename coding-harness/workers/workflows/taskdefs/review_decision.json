{
  "name": "review_decision",
  "description": "Deterministic decision step, replacing a JSON_JQ_TRANSFORM.",
  "retryCount": 1,
  "retryLogic": "FIXED",
  "retryDelaySeconds": 1,
  "timeoutSeconds": 0,
  "responseTimeoutSeconds": 0,
  "pollTimeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "ownerEmail": "viren@orkes.io",
  "inputSchema": {
    "name": "review_decision_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "gate": {
          "type": "object",
          "description": "The WAIT gate's raw payload: {action?, approved?, feedback?, review? or artifact?}. Reduced to one of approve/investigate/revise/stop/unknown.",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "approve",
                "investigate",
                "revise",
                "stop"
              ]
            },
            "approved": {
              "type": "boolean"
            },
            "feedback": {
              "type": "string"
            },
            "review": {
              "type": "object"
            },
            "artifact": {
              "type": "object"
            }
          }
        },
        "canInvestigate": {
          "type": "boolean",
          "description": "Whether the investigation budget still allows another pass; action='investigate' is only honored when this is exactly true."
        },
        "fallbackReview": {
          "description": "Review payload used when the gate itself carries no review/artifact."
        }
      }
    }
  },
  "outputSchema": {
    "name": "review_decision_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "approve",
            "investigate",
            "revise",
            "stop",
            "unknown"
          ],
          "description": "The resolved reviewer action."
        },
        "feedback": {
          "type": "string",
          "description": "Free-text feedback from the gate, if any."
        },
        "review": {
          "description": "The review payload: gate.review, or gate.artifact, or fallbackReview, whichever is first present."
        }
      },
      "required": [
        "action",
        "feedback",
        "review"
      ]
    }
  }
}
