{
  "name": "pr_comment",
  "description": "Comment on a PR (gh pr comment). Input: repoPath, number, body.",
  "retryCount": 1,
  "retryLogic": "FIXED",
  "retryDelaySeconds": 5,
  "timeoutSeconds": 0,
  "responseTimeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "ownerEmail": "viren@orkes.io",
  "pollTimeoutSeconds": 0,
  "inputSchema": {
    "name": "pr_comment_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "description": "Local git checkout used to resolve the PR (unless repo/repoUrl is supplied)."
        },
        "number": {
          "type": [
            "integer",
            "string"
          ],
          "description": "PR number to comment on."
        },
        "body": {
          "type": "string",
          "description": "Comment body text. A hidden harness marker is appended if not already present."
        },
        "repo": {
          "type": "string",
          "description": "Repository (owner/name or URL) to comment against directly, overriding repoPath's remote resolution."
        },
        "repoUrl": {
          "type": "string",
          "description": "Alternate spelling for 'repo'; used when 'repo' is not supplied."
        }
      },
      "required": [
        "repoPath",
        "number"
      ]
    }
  },
  "outputSchema": {
    "name": "pr_comment_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "commented": {
          "type": "boolean",
          "description": "Always true on success."
        },
        "number": {
          "type": "integer",
          "description": "PR number that was commented on."
        },
        "url": {
          "type": "string",
          "description": "URL of the posted comment."
        }
      },
      "required": [
        "commented",
        "number",
        "url"
      ]
    }
  }
}
