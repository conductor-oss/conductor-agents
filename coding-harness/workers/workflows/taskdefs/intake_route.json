{
  "name": "intake_route",
  "description": "SDLC intake (roadmap Phase 4, G1): fold a classifier's output into the routing decision. Low confidence routes to a bounded clarify gate (when a human is available); otherwise two-dimensional routing by kind (bug/greenfield/feature/refactor/chore) and execution mode (single code_parallel vs team_build, read off the decomposition, H9/H12).",
  "retryCount": 1, "retryLogic": "FIXED", "retryDelaySeconds": 1,
  "timeoutSeconds": 0, "responseTimeoutSeconds": 0, "pollTimeoutSeconds": 0, "timeoutPolicy": "ALERT_ONLY",
  "ownerEmail": "viren@orkes.io",
  "inputSchema": {"name": "intake_route_input", "type": "JSON", "data": {"type": "object", "properties": {
    "classification": {"type": ["object", "string"], "description": "The classifier (coding_agent) output: {kind,size,confidence,instruction,acceptanceCriteria,subtasks,contractPaths}."},
    "confidenceThreshold": {"type": ["number", "string"], "description": "Below this, route to the clarify gate."},
    "humanAvailable": {"type": ["boolean", "string"], "description": "False skips the clarify gate (proceed on best classification)."},
    "forceSingle": {"type": ["boolean", "string"]}, "forceTeam": {"type": ["boolean", "string"]}
  }}},
  "outputSchema": {"name": "intake_route_output", "type": "JSON", "data": {"type": "object", "properties": {
    "route": {"type": "string", "enum": ["clarify", "bug", "greenfield", "team", "single"]},
    "kind": {"type": "string"}, "confidence": {"type": "number"}, "size": {"type": "string"},
    "instruction": {"type": "string"}, "acceptanceCriteria": {"type": "array"}, "subtasks": {"type": "array"},
    "contractPaths": {"type": "array"}, "itemCount": {"type": "integer"}, "summary": {"type": "string"}
  }, "required": ["route", "kind"]}}
}
