{
  "name": "swarm",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "viren@orkes.io",
  "description": "The simple swarm: an architect agent designs, writes acceptance checks and splits the work; a team of agents builds the items in parallel in ONE shared private clone, committing and combining their own work and reasoning about any conflict; the harness measures the architect's checks and the architect judges each round and names the next items, until delivered or the budget is spent. The harness provisions, fans out, measures and loops; it makes no judgments.",
  "inputParameters": [
    "repoPath",
    "description",
    "branchName",
    "maxRounds",
    "maxWidth",
    "ceilingUsd",
    "modelProfile",
    "modelPolicy",
    "modelPolicySource",
    "modelPolicySha256",
    "modelsConfig",
    "modelOverrides",
    "link",
    "base",
    "publish",
    "ready",
    "ciRounds",
    "ciRound",
    "commentOnIssue",
    "closesIssue",
    "permissionWaitMinutes",
    "specs",
    "design",
    "publishHarnessFiles",
    "restoreHarnessFrom"
  ],
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0,
  "restartable": true,
  "tasks": [
    {
      "name": "model_profile_resolve",
      "taskReferenceName": "model_policy",
      "type": "SIMPLE",
      "inputParameters": {
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "repoPath": "${workflow.input.repoPath}"
      }
    },
    {
      "name": "swarm_intake",
      "taskReferenceName": "intake",
      "type": "SIMPLE",
      "inputParameters": {
        "link": "${workflow.input.link}",
        "repoPath": "${workflow.input.repoPath}",
        "description": "${workflow.input.description}",
        "branchName": "${workflow.input.branchName}",
        "base": "${workflow.input.base}",
        "publish": "${workflow.input.publish}",
        "ready": "${workflow.input.ready}",
        "runId": "${workflow.workflowId}",
        "restoreHarnessFrom": "${workflow.input.restoreHarnessFrom}"
      }
    },
    {
      "name": "repo_memory_read",
      "taskReferenceName": "memory_read",
      "type": "SIMPLE",
      "inputParameters": {
        "repoPath": "${intake.output.repoPath}"
      }
    },
    {
      "name": "swarm_setup",
      "taskReferenceName": "setup",
      "type": "SIMPLE",
      "inputParameters": {
        "repoPath": "${intake.output.repoPath}",
        "description": "${intake.output.description}",
        "runId": "${workflow.workflowId}",
        "branchName": "${intake.output.branchName}",
        "modelResolution": "${model_policy.output}",
        "startFrom": "${intake.output.startFrom}",
        "specs": "${workflow.input.specs}",
        "design": "${workflow.input.design}",
        "restoreHarnessFrom": "${intake.output.restoreHarnessFrom}"
      }
    },
    {
      "name": "formal_feedback_init",
      "taskReferenceName": "formal_feedback_init",
      "type": "SET_VARIABLE",
      "inputParameters": {
        "formalFeedback": ""
      }
    },
    {
      "name": "planning",
      "taskReferenceName": "planning",
      "type": "DO_WHILE",
      "evaluatorType": "graaljs",
      "loopCondition": "(function(){ var cur = $.planning[String($.planning['iteration'])] || {}; var proven = (cur['formal'] || {})['ok']; return $.planning['iteration'] < $.max_tries && proven !== true; })();",
      "inputParameters": {
        "max_tries": 3,
        "planning": "${planning.output}"
      },
      "loopOver": [
        {
          "name": "coding_agent",
          "taskReferenceName": "plan",
          "type": "SIMPLE",
          "inputParameters": {
            "worktreePath": "${setup.output.workdir}",
            "modelRole": "design",
            "sharedTree": true,
            "allowedWriteRoots": [],
            "allowedTools": "${setup.output.allowedTools}",
            "disallowedTools": "${setup.output.disallowedTools}",
            "feedbackCorrelationId": "${workflow.workflowId}",
            "feedbackRunId": "${workflow.workflowId}",
            "feedbackItem": "architect",
            "modelProfile": "${workflow.input.modelProfile}",
            "modelPolicy": "${workflow.input.modelPolicy}",
            "modelPolicySource": "${workflow.input.modelPolicySource}",
            "modelPolicySha256": "${workflow.input.modelPolicySha256}",
            "templateKey": "swarm_plan",
            "promptContext": {
              "request": "${intake.output.description}",
              "branch": "${setup.output.branch}",
              "memory": "${memory_read.output.digest}",
              "history": "${setup.output.history}",
              "ladder": "${setup.output.ladder}",
              "maxRung": "${setup.output.maxRung}",
              "formalFeedback": "${workflow.variables.formalFeedback}",
              "specGuide": "${setup.output.specGuide}",
              "designGuide": "${setup.output.designGuide}",
              "existingChecks": "${setup.output.existingChecks}"
            },
            "schema": "${setup.output.schemas.plan}",
            "modelsConfig": "${workflow.input.modelsConfig}",
            "modelOverrides": "${workflow.input.modelOverrides}",
            "modelResolution": "${model_policy.output}",
            "promptTemplate": "",
            "promptTemplateSource": "",
            "spendRunId": "${workflow.workflowId}",
            "spendAuthor": "architect"
          }
        },
        {
          "name": "swarm_formal",
          "taskReferenceName": "formal",
          "type": "SIMPLE",
          "inputParameters": {
            "workdir": "${setup.output.workdir}",
            "plan": "${plan.output}",
            "specs": "${setup.output.specs}",
            "design": "${setup.output.design}",
            "existingSpec": "${setup.output.existingSpec}"
          }
        },
        {
          "name": "formal_feedback",
          "taskReferenceName": "formal_feedback",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "formalFeedback": "${formal.output.feedback}"
          }
        }
      ]
    },
    {
      "name": "swarm_authoring",
      "taskReferenceName": "authoring",
      "type": "SIMPLE",
      "inputParameters": {
        "workdir": "${setup.output.workdir}",
        "plan": "${plan.output}",
        "runId": "${workflow.workflowId}",
        "description": "${intake.output.description}",
        "branch": "${setup.output.branch}",
        "ceilingUsd": "${workflow.input.ceilingUsd}",
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "modelResolution": "${model_policy.output}",
        "specKind": "${formal.output.kind}"
      }
    },
    {
      "name": "authors",
      "taskReferenceName": "authors",
      "type": "FORK_JOIN_DYNAMIC",
      "optional": true,
      "inputParameters": {
        "dynamicTasks": "${authoring.output.dynamicTasks}",
        "dynamicTasksInput": "${authoring.output.dynamicTasksInput}"
      },
      "dynamicForkTasksParam": "dynamicTasks",
      "dynamicForkTasksInputParamName": "dynamicTasksInput"
    },
    {
      "name": "authors_join",
      "taskReferenceName": "authors_join",
      "type": "JOIN",
      "joinMode": "SYNC",
      "optional": true
    },
    {
      "name": "seed_round",
      "taskReferenceName": "seed_round",
      "type": "SET_VARIABLE",
      "inputParameters": {
        "items": "${plan.output.structured.items}"
      }
    },
    {
      "name": "rounds",
      "taskReferenceName": "rounds",
      "type": "DO_WHILE",
      "evaluatorType": "graaljs",
      "loopCondition": "(function(){ var cur = $.rounds[String($.rounds['iteration'])] || {}; var stop = (cur['decide'] || {})['stop']; return $.rounds['iteration'] < $.max_rounds && stop !== true; })();",
      "inputParameters": {
        "max_rounds": "${workflow.input.maxRounds}",
        "rounds": "${rounds.output}"
      },
      "loopOver": [
        {
          "name": "swarm_dispatch",
          "taskReferenceName": "dispatch",
          "type": "SIMPLE",
          "inputParameters": {
            "items": "${workflow.variables.items}",
            "round": "${rounds.output.iteration}",
            "workdir": "${setup.output.workdir}",
            "branch": "${setup.output.branch}",
            "description": "${intake.output.description}",
            "runId": "${workflow.workflowId}",
            "maxWidth": "${workflow.input.maxWidth}",
            "modelProfile": "${workflow.input.modelProfile}",
            "modelPolicy": "${workflow.input.modelPolicy}",
            "modelPolicySource": "${workflow.input.modelPolicySource}",
            "modelPolicySha256": "${workflow.input.modelPolicySha256}",
            "modelsConfig": "${workflow.input.modelsConfig}",
            "modelOverrides": "${workflow.input.modelOverrides}",
            "ceilingUsd": "${workflow.input.ceilingUsd}",
            "repoPath": "${intake.output.repoPath}",
            "specBrief": "${formal.output.brief}"
          }
        },
        {
          "name": "work",
          "taskReferenceName": "work",
          "type": "FORK_JOIN_DYNAMIC",
          "optional": true,
          "inputParameters": {
            "dynamicTasks": "${dispatch.output.dynamicTasks}",
            "dynamicTasksInput": "${dispatch.output.dynamicTasksInput}"
          },
          "dynamicForkTasksParam": "dynamicTasks",
          "dynamicForkTasksInputParamName": "dynamicTasksInput"
        },
        {
          "name": "work_join",
          "taskReferenceName": "work_join",
          "type": "JOIN",
          "joinMode": "SYNC",
          "optional": true
        },
        {
          "name": "swarm_round",
          "taskReferenceName": "fold",
          "type": "SIMPLE",
          "inputParameters": {
            "runId": "${workflow.workflowId}",
            "round": "${rounds.output.iteration}",
            "repoPath": "${intake.output.repoPath}",
            "modelResolution": "${model_policy.output}"
          }
        },
        {
          "name": "swarm_measure",
          "taskReferenceName": "measure",
          "type": "SIMPLE",
          "inputParameters": {
            "workdir": "${setup.output.workdir}",
            "label": "swarm round ${rounds.output.iteration}",
            "specKind": "${formal.output.kind}"
          }
        },
        {
          "name": "coding_agent",
          "taskReferenceName": "evaluate",
          "type": "SIMPLE",
          "inputParameters": {
            "worktreePath": "${setup.output.workdir}",
            "modelRole": "review",
            "sharedTree": true,
            "allowedWriteRoots": [],
            "allowedTools": "${setup.output.allowedTools}",
            "disallowedTools": "${setup.output.disallowedTools}",
            "feedbackCorrelationId": "${workflow.workflowId}",
            "feedbackRunId": "${workflow.workflowId}",
            "feedbackItem": "architect",
            "modelProfile": "${workflow.input.modelProfile}",
            "modelPolicy": "${workflow.input.modelPolicy}",
            "modelPolicySource": "${workflow.input.modelPolicySource}",
            "modelPolicySha256": "${workflow.input.modelPolicySha256}",
            "templateKey": "swarm_evaluate",
            "promptContext": {
              "request": "${intake.output.description}",
              "branch": "${setup.output.branch}",
              "memory": "${memory_read.output.digest}",
              "history": "${setup.output.history}",
              "ladder": "${setup.output.ladder}",
              "maxRung": "${setup.output.maxRung}",
              "round": "${rounds.output.iteration}",
              "reports": "${fold.output.reports}",
              "measurement": "${measure.output.summary}",
              "changes": "${measure.output.changes}",
              "permissions": "${fold.output.permissions}",
              "spec": "${formal.output.brief}"
            },
            "schema": "${setup.output.schemas.evaluate}",
            "modelsConfig": "${workflow.input.modelsConfig}",
            "modelOverrides": "${workflow.input.modelOverrides}",
            "modelResolution": "${model_policy.output}",
            "promptTemplate": "",
            "promptTemplateSource": "",
            "modelTier": "${fold.output.roundReviewRung}",
            "spendRunId": "${workflow.workflowId}",
            "spendAuthor": "architect",
            "writableRoots": "${fold.output.writableRoots}",
            "allowedDomains": "${fold.output.allowedDomains}"
          }
        },
        {
          "name": "swarm_measure",
          "taskReferenceName": "remeasure",
          "type": "SIMPLE",
          "inputParameters": {
            "workdir": "${setup.output.workdir}",
            "label": "swarm round ${rounds.output.iteration}: architect review",
            "previous": "${measure.output}",
            "specKind": "${formal.output.kind}"
          }
        },
        {
          "name": "swarm_round",
          "taskReferenceName": "decide",
          "type": "SIMPLE",
          "inputParameters": {
            "evaluation": "${evaluate.output}",
            "allGreen": "${remeasure.output.allGreen}",
            "ceilingUsd": "${workflow.input.ceilingUsd}",
            "runId": "${workflow.workflowId}",
            "round": "${rounds.output.iteration}",
            "repoPath": "${intake.output.repoPath}",
            "roundReviewRung": "${fold.output.roundReviewRung}"
          }
        },
        {
          "name": "swarm_permissions",
          "taskReferenceName": "permissions",
          "type": "SIMPLE",
          "inputParameters": {
            "evaluation": "${evaluate.output}",
            "delivered": "${decide.output.delivered}",
            "stop": "${decide.output.stop}",
            "runId": "${workflow.workflowId}",
            "round": "${rounds.output.iteration}",
            "workdir": "${setup.output.workdir}",
            "repoPath": "${intake.output.repoPath}",
            "target": "${intake.output.target}",
            "waitMinutes": "${workflow.input.permissionWaitMinutes}"
          }
        },
        {
          "name": "next",
          "taskReferenceName": "next",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "items": "${decide.output.items}",
            "delivered": "${decide.output.delivered}",
            "assessment": "${decide.output.assessment}",
            "spentUsd": "${decide.output.spentUsd}"
          }
        }
      ]
    },
    {
      "name": "repo_memory_write",
      "taskReferenceName": "memory_write",
      "type": "SIMPLE",
      "optional": true,
      "inputParameters": {
        "repoPath": "${setup.output.workdir}",
        "correlationId": "${workflow.workflowId}"
      }
    },
    {
      "name": "swarm_finish",
      "taskReferenceName": "finish",
      "type": "SIMPLE",
      "inputParameters": {
        "repoPath": "${intake.output.repoPath}",
        "workdir": "${setup.output.workdir}",
        "branch": "${setup.output.branch}",
        "delivered": "${workflow.variables.delivered}",
        "originalBranch": "${setup.output.originalBranch}",
        "originalHead": "${setup.output.originalHead}"
      }
    },
    {
      "name": "swarm_publish",
      "taskReferenceName": "publish",
      "type": "SIMPLE",
      "inputParameters": {
        "target": "${intake.output.target}",
        "publish": "${intake.output.publish}",
        "repoPath": "${intake.output.repoPath}",
        "branch": "${finish.output.branch}",
        "head": "${finish.output.head}",
        "delivered": "${finish.output.delivered}",
        "workdir": "${setup.output.workdir}",
        "base": "${setup.output.base}",
        "assessment": "${workflow.variables.assessment}",
        "spendUsd": "${workflow.variables.spentUsd}",
        "rounds": "${rounds.output.iteration}",
        "publishHarnessFiles": "${workflow.input.publishHarnessFiles}",
        "specKind": "${formal.output.kind}",
        "runId": "${workflow.workflowId}"
      }
    },
    {
      "name": "swarm_ci",
      "taskReferenceName": "ci",
      "type": "SIMPLE",
      "inputParameters": {
        "target": "${intake.output.target}",
        "pullRequest": "${publish.output.pullRequest}",
        "ciRounds": "${workflow.input.ciRounds}",
        "ciRound": "${workflow.input.ciRound}",
        "ceilingUsd": "${workflow.input.ceilingUsd}",
        "spentUsd": "${workflow.variables.spentUsd}"
      }
    },
    {
      "name": "after_ci",
      "taskReferenceName": "after_ci",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "next",
      "inputParameters": {
        "next": "${ci.output.next}"
      },
      "decisionCases": {
        "ready": [
          {
            "name": "swarm_pr_ready",
            "taskReferenceName": "pr_ready",
            "type": "SIMPLE",
            "inputParameters": {
              "target": "${intake.output.target}",
              "pullRequest": "${publish.output.pullRequest}",
              "ready": "${intake.output.ready}",
              "commentOnIssue": "${workflow.input.commentOnIssue}",
              "closesIssue": "${workflow.input.closesIssue}"
            }
          }
        ],
        "followup": [
          {
            "name": "swarm",
            "taskReferenceName": "followup",
            "type": "SUB_WORKFLOW",
            "subWorkflowParam": {
              "name": "swarm"
            },
            "inputParameters": {
              "link": "${publish.output.pullRequest.url}",
              "description": "${ci.output.request}",
              "repoPath": "${intake.output.repoPath}",
              "publish": "pr",
              "ready": "${intake.output.ready}",
              "ciRounds": "${workflow.input.ciRounds}",
              "ciRound": "${ci.output.nextRound}",
              "ceilingUsd": "${ci.output.remainingUsd}",
              "maxRounds": "${workflow.input.maxRounds}",
              "maxWidth": "${workflow.input.maxWidth}",
              "commentOnIssue": "${workflow.input.commentOnIssue}",
              "closesIssue": "${intake.output.target.number}",
              "modelProfile": "${workflow.input.modelProfile}",
              "modelPolicy": "${workflow.input.modelPolicy}",
              "modelPolicySource": "${workflow.input.modelPolicySource}",
              "modelPolicySha256": "${workflow.input.modelPolicySha256}",
              "modelsConfig": "${workflow.input.modelsConfig}",
              "modelOverrides": "${workflow.input.modelOverrides}",
              "specs": "${workflow.input.specs}",
              "design": "${workflow.input.design}",
              "publishHarnessFiles": "${workflow.input.publishHarnessFiles}",
              "restoreHarnessFrom": "${publish.output.harnessRef}"
            }
          }
        ]
      },
      "defaultCase": []
    }
  ],
  "outputParameters": {
    "verdict": "${finish.output.verdict}",
    "delivered": "${finish.output.delivered}",
    "sourceHandoff": "${finish.output.sourceHandoff}",
    "branch": "${finish.output.branch}",
    "head": "${finish.output.head}",
    "assessment": "${workflow.variables.assessment}",
    "spendUsd": "${workflow.variables.spentUsd}",
    "rounds": "${rounds.output.iteration}",
    "pullRequest": "${publish.output.pullRequest}",
    "ci": "${ci.output.state}",
    "readyForReview": "${pr_ready.output.ready}",
    "followUp": "${followup.output}",
    "target": "${intake.output.target}",
    "spec": {
      "kind": "${formal.output.kind}",
      "why": "${formal.output.why}",
      "summary": "${formal.output.summary}"
    },
    "designDocs": "${formal.output.designDocs}"
  },
  "inputTemplate": {
    "maxRounds": 8,
    "maxWidth": 10,
    "ceilingUsd": 60,
    "modelProfile": "",
    "modelPolicy": {},
    "modelPolicySource": "",
    "modelPolicySha256": "",
    "modelsConfig": "",
    "modelOverrides": {},
    "branchName": "",
    "repoPath": "",
    "description": "",
    "link": "",
    "base": "",
    "publish": "",
    "ready": "",
    "ciRounds": 2,
    "ciRound": 0,
    "commentOnIssue": false,
    "closesIssue": 0,
    "permissionWaitMinutes": 0,
    "specs": "auto",
    "design": "auto",
    "publishHarnessFiles": false,
    "restoreHarnessFrom": ""
  }
}
