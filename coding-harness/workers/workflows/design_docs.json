{
  "name": "design_docs",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "viren@orkes.io",
  "description": "Iteratively create and review coherent design docs before coding. Approval ends the loop; feedback drives the next pass; the bounded loop fails closed if no design is approved.",
  "timeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "inputParameters": [
    "designAgent",
    "designDir",
    "designMaxBudgetUsd",
    "designMaxIterations",
    "designMaxTurns",
    "designModel",
    "designPromptTemplate",
    "designPromptTemplateSource",
    "humanApproval",
    "failClosed",
    "callerWorkflow",
    "instruction",
    "modelOverrides",
    "modelPolicy",
    "modelPolicySha256",
    "modelPolicySource",
    "modelProfile",
    "modelsConfig",
    "repoPath",
    "contextPaths"
  ],
  "inputTemplate": {
    "designDir": "docs/design",
    "designAgent": "",
    "designModel": "",
    "designPromptTemplate": "",
    "designPromptTemplateSource": "",
    "designMaxTurns": 500,
    "designMaxBudgetUsd": 50,
    "humanApproval": true,
    "failClosed": true,
    "designMaxIterations": 5,
    "modelProfile": "",
    "modelPolicy": {},
    "modelPolicySource": "",
    "modelPolicySha256": "",
    "modelsConfig": "",
    "modelOverrides": {},
    "contextPaths": []
  },
  "variables": {
    "designApproved": false,
    "designStopped": false,
    "designFeedback": "",
    "designReview": "",
    "lastFilesChanged": [],
    "lastAgent": "",
    "lastCostUsd": 0,
    "lastTokenUsed": 0,
    "lastSessionId": "",
    "lastPromptTemplate": {},
    "designCommit": "",
    "currentMaxTurns": 500,
    "currentMaxBudgetUsd": 50
  },
  "tasks": [
    {
      "name": "model_profile_resolve",
      "taskReferenceName": "model_policy",
      "type": "SIMPLE",
      "inputParameters": {
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "repoPath": "${workflow.input.repoPath}"
      }
    },
    {
      "name": "design_init",
      "taskReferenceName": "design_init",
      "type": "SET_VARIABLE",
      "inputParameters": {
        "currentMaxTurns": "${workflow.input.designMaxTurns}",
        "currentMaxBudgetUsd": "${workflow.input.designMaxBudgetUsd}"
      }
    },
    {
      "name": "design_loop",
      "taskReferenceName": "design_loop",
      "type": "DO_WHILE",
      "evaluatorType": "graaljs",
      "loopCondition": "(function(){ return $.design_loop['iteration'] < $.max_iterations && $.approved !== true && $.approved !== 'true' && !$.stopped; })();",
      "inputParameters": {
        "design_loop": "${design_loop.output}",
        "max_iterations": "${workflow.input.designMaxIterations}",
        "approved": "${workflow.variables.designApproved}",
        "stopped": "${workflow.variables.designStopped}"
      },
      "loopOver": [
        {
          "name": "coding_agent",
          "taskReferenceName": "design",
          "type": "SIMPLE",
          "inputParameters": {
            "worktreePath": "${workflow.input.repoPath}",
            "contextPaths": "${workflow.input.contextPaths}",
            "agent": "${workflow.input.designAgent}",
            "model": "${workflow.input.designModel}",
            "maxTurns": "${workflow.variables.currentMaxTurns}",
            "maxBudgetUsd": "${workflow.variables.currentMaxBudgetUsd}",
            "allowedWriteRoots": [
              "${workflow.input.designDir}"
            ],
            "templateKey": "design",
            "promptTemplate": "${workflow.input.designPromptTemplate}",
            "promptTemplateSource": "${workflow.input.designPromptTemplateSource}",
            "promptContext": {
              "instruction": "${workflow.input.instruction}",
              "designDir": "${workflow.input.designDir}",
              "feedback": "${workflow.variables.designFeedback}"
            },
            "prompt": "You are a senior software architect. Create or revise mutually consistent GitHub-flavored markdown design documents under ${workflow.input.designDir}/. Read existing design docs first. architecture.md is the source of truth for complete file layout, shared contracts, exact types, interfaces, data model, and naming conventions. Write only markdown design docs; do not write application code. Reconcile any direct worktree edits a reviewer made to the design docs themselves.\n\nRequested change:\n${workflow.input.instruction}\n\nPrevious review feedback (empty on first pass):\n${workflow.variables.designFeedback}\n\nAddress every feedback item, then summarize the design and files changed.",
            "modelRole": "design",
            "modelProfile": "${workflow.input.modelProfile}",
            "modelPolicy": "${workflow.input.modelPolicy}",
            "modelPolicySource": "${workflow.input.modelPolicySource}",
            "modelPolicySha256": "${workflow.input.modelPolicySha256}",
            "modelsConfig": "${workflow.input.modelsConfig}",
            "modelOverrides": "${workflow.input.modelOverrides}",
            "modelResolution": "${model_policy.output}"
          }
        },
        {
          "name": "capture_design_result",
          "taskReferenceName": "capture_design_result",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "lastFilesChanged": "${design.output.filesChanged}",
            "lastAgent": "${design.output.agent}",
            "lastCostUsd": "${design.output.costUsd}",
            "lastTokenUsed": "${design.output.tokenUsed}",
            "lastSessionId": "${design.output.sessionId}",
            "lastPromptTemplate": "${design.output.promptTemplate}"
          }
        },
        {
          "name": "review_mode",
          "taskReferenceName": "review_mode",
          "type": "SWITCH",
          "evaluatorType": "value-param",
          "expression": "humanApproval",
          "inputParameters": {
            "humanApproval": "${workflow.input.humanApproval}"
          },
          "decisionCases": {
            "true": [
              {
                "name": "design_review",
                "taskReferenceName": "design_review",
                "type": "WAIT",
                "inputParameters": {
                  "workflow": "${workflow.input.callerWorkflow}",
                  "phase": "design",
                  "availableActions": [
                    "continue",
                    "revise",
                    "adopt_edits",
                    "stop"
                  ],
                  "repoPath": "${workflow.input.repoPath}",
                  "designDir": "${workflow.input.designDir}",
                  "draft": {
                    "kind": "design",
                    "designDir": "${workflow.input.designDir}",
                    "filesChanged": "${design.output.filesChanged}",
                    "summary": "${design.output.result}"
                  }
                }
              },
              {
                "name": "design_review_normalize",
                "taskReferenceName": "design_review_normalize",
                "type": "INLINE",
                "evaluatorType": "graaljs",
                "inputParameters": {
                  "decision": "${design_review.output}",
                  "expression": "(function(){ var d = $.decision || {}; var action = d.action; var known = ['continue', 'revise', 'adopt_edits', 'stop']; if (known.indexOf(action) === -1) { action = (d.approved === true || d.approved === 'true') ? 'continue' : 'revise'; } return {action: action, feedback: d.feedback || ''}; })();"
                }
              },
              {
                "name": "campaign_checkpoint",
                "taskReferenceName": "design_review_checkpoint",
                "type": "SIMPLE",
                "inputParameters": {
                  "decision": "${design_review_normalize.output.result}",
                  "phase": "design",
                  "blockingStatus": "${design.output.status}",
                  "maxTurns": "${workflow.variables.currentMaxTurns}",
                  "maxBudgetUsd": "${workflow.variables.currentMaxBudgetUsd}"
                }
              },
              {
                "name": "design_limits",
                "taskReferenceName": "design_limits",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "currentMaxTurns": "${design_review_checkpoint.output.maxTurns}",
                  "currentMaxBudgetUsd": "${design_review_checkpoint.output.maxBudgetUsd}"
                }
              },
              {
                "name": "design_review_action",
                "taskReferenceName": "design_review_action",
                "type": "SWITCH",
                "evaluatorType": "value-param",
                "expression": "action",
                "inputParameters": {
                  "action": "${design_review_checkpoint.output.action}"
                },
                "decisionCases": {
                  "continue": [
                    {
                      "name": "design_approved",
                      "taskReferenceName": "design_approved",
                      "type": "SET_VARIABLE",
                      "inputParameters": {
                        "designApproved": true,
                        "designFeedback": "",
                        "designReview": "human"
                      }
                    }
                  ],
                  "stop": [
                    {
                      "name": "design_stopped",
                      "taskReferenceName": "design_stopped",
                      "type": "SET_VARIABLE",
                      "inputParameters": {
                        "designStopped": true,
                        "designFeedback": "${design_review_checkpoint.output.feedback}",
                        "designReview": "human"
                      }
                    }
                  ]
                },
                "defaultCase": [
                  {
                    "name": "design_revision",
                    "taskReferenceName": "design_revision",
                    "type": "SET_VARIABLE",
                    "inputParameters": {
                      "designFeedback": "${design_review_checkpoint.output.feedback}",
                      "designReview": "human"
                    }
                  }
                ]
              }
            ]
          },
          "defaultCase": [
            {
              "name": "coding_agent",
              "taskReferenceName": "design_judge",
              "type": "SIMPLE",
              "inputParameters": {
                "worktreePath": "${workflow.input.repoPath}",
                "agent": "${workflow.input.designAgent}",
                "model": "${workflow.input.designModel}",
                "maxTurns": "${workflow.input.designMaxTurns}",
                "maxBudgetUsd": "${workflow.input.designMaxBudgetUsd}",
                "templateKey": "design-judge",
                "promptTemplate": "",
                "promptTemplateSource": "builtin:design-judge",
                "tools": [
                  "Read",
                  "Grep",
                  "Glob"
                ],
                "schema": {
                  "type": "object",
                  "required": [
                    "approved",
                    "feedback"
                  ],
                  "properties": {
                    "approved": {
                      "type": "boolean"
                    },
                    "feedback": {
                      "type": "string"
                    }
                  }
                },
                "prompt": "Act as a read-only software design judge. Read the design documents under ${workflow.input.designDir}/, especially architecture.md, and compare them with the requested change below. Judge whether the design is complete, internally consistent, implementable, testable, and ready for parallel coding. Approve only when shared contracts, exact types, file layout, data model, APIs, failure handling, migration/compatibility concerns, and testing are sufficiently specified. Return the required structured output with approved (boolean) and concise actionable feedback (string). Do not edit any files.\n\nRequested change:\n${workflow.input.instruction}\n\nAuthor summary:\n${design.output.result}",
                "modelRole": "judge",
                "modelProfile": "${workflow.input.modelProfile}",
                "modelPolicy": "${workflow.input.modelPolicy}",
                "modelPolicySource": "${workflow.input.modelPolicySource}",
                "modelPolicySha256": "${workflow.input.modelPolicySha256}",
                "modelsConfig": "${workflow.input.modelsConfig}",
                "modelOverrides": "${workflow.input.modelOverrides}",
                "modelResolution": "${model_policy.output}"
              }
            },
            {
              "name": "set_judge_review",
              "taskReferenceName": "set_judge_review",
              "type": "SET_VARIABLE",
              "inputParameters": {
                "designApproved": "${design_judge.output.structured.approved}",
                "designFeedback": "${design_judge.output.structured.feedback}",
                "designReview": "agent"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "approval_result",
      "taskReferenceName": "approval_result",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "approved",
      "inputParameters": {
        "approved": "${workflow.variables.designApproved}"
      },
      "decisionCases": {
        "true": [
          {
            "name": "commit",
            "taskReferenceName": "commit_design",
            "type": "SIMPLE",
            "inputParameters": {
              "repoPath": "${workflow.input.repoPath}",
              "message": "approved design docs (${workflow.input.designDir})"
            }
          },
          {
            "name": "capture_design_commit",
            "taskReferenceName": "capture_design_commit",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "designCommit": "${commit_design.output.commit}"
            }
          }
        ]
      },
      "defaultCase": [
        {
          "name": "fail_closed_gate",
          "taskReferenceName": "fail_closed_gate",
          "type": "SWITCH",
          "evaluatorType": "value-param",
          "expression": "failClosed",
          "inputParameters": {
            "failClosed": "${workflow.input.failClosed}"
          },
          "decisionCases": {
            "true": [
              {
                "name": "design_not_approved",
                "taskReferenceName": "design_not_approved",
                "type": "TERMINATE",
                "inputParameters": {
                  "terminationStatus": "FAILED",
                  "terminationReason": "Design was not approved (stopped, or the iteration limit was reached).",
                  "workflowOutput": {
                    "approved": false,
                    "feedback": "${workflow.variables.designFeedback}"
                  }
                }
              }
            ]
          },
          "defaultCase": []
        }
      ]
    }
  ],
  "outputParameters": {
    "approved": "${workflow.variables.designApproved}",
    "stopped": "${workflow.variables.designStopped}",
    "reviewMode": "${workflow.variables.designReview}",
    "feedback": "${workflow.variables.designFeedback}",
    "iterations": "${design_loop.output.iteration}",
    "filesChanged": "${workflow.variables.lastFilesChanged}",
    "agent": "${workflow.variables.lastAgent}",
    "costUsd": "${workflow.variables.lastCostUsd}",
    "tokenUsed": "${workflow.variables.lastTokenUsed}",
    "sessionId": "${workflow.variables.lastSessionId}",
    "designCommit": "${workflow.variables.designCommit}",
    "finalMaxTurns": "${workflow.variables.currentMaxTurns}",
    "finalMaxBudgetUsd": "${workflow.variables.currentMaxBudgetUsd}",
    "promptTemplate": "${workflow.variables.lastPromptTemplate}"
  },
  "inputSchema": {
    "name": "design_docs_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "description": "Absolute path to the git checkout the design docs are authored and committed in."
        },
        "callerWorkflow": {
          "type": "string",
          "description": "The logical top-level workflow name (e.g. 'feature_campaign', 'issue_to_pr', 'code_parallel', 'address_pr') to stamp onto the design_review WAIT payload. design_docs is reused by multiple callers, some nested two levels deep (issue_to_pr -> code_parallel -> design_docs); without this, the TUI's approval dispatch would see this sub-workflow's own name instead of the caller's, and every approve/revise/stop decision on it would resolve to the wrong branch."
        },
        "instruction": {
          "type": "string",
          "description": "Requested design change; drives both the authoring and (agent-mode) judging prompts."
        },
        "designDir": {
          "type": "string",
          "default": "docs/design",
          "description": "Repository-relative directory the design agent may write markdown docs into."
        },
        "designAgent": {
          "type": "string",
          "default": "",
          "description": "Coding agent identifier used for both the design-authoring and design-judge sessions."
        },
        "designModel": {
          "type": "string",
          "default": "",
          "description": "Legacy single-model override applied to the design-authoring and design-judge sessions."
        },
        "designPromptTemplate": {
          "type": "string",
          "default": "",
          "description": "Inline prompt template for the design-authoring session."
        },
        "designPromptTemplateSource": {
          "type": "string",
          "default": "",
          "description": "Provenance label for the design prompt template."
        },
        "designMaxTurns": {
          "type": "integer",
          "default": 500,
          "description": "Maximum agent turns allowed per design-authoring or design-judge session."
        },
        "designMaxBudgetUsd": {
          "type": "number",
          "default": 50,
          "description": "Maximum USD spend allowed per design-authoring or design-judge session."
        },
        "humanApproval": {
          "type": "boolean",
          "default": true,
          "description": "When true, each design iteration is reviewed by a human WAIT task (which may also request bounded turn/budget increases via the shared campaign-checkpoint decision shape, or explicitly stop early); when false, an agent design-judge session reviews it instead (fixed turns/budget, no early stop)."
        },
        "failClosed": {
          "type": "boolean",
          "default": true,
          "description": "When true (the default -- matches every existing caller), a design never approved (stopped early, or the iteration limit reached) TERMINATEs the whole workflow FAILED. When false, the workflow completes normally instead with approved:false in its output, leaving the caller free to degrade gracefully (e.g. feature_campaign marks its own outcome incomplete rather than failing the entire campaign)."
        },
        "designMaxIterations": {
          "type": "integer",
          "default": 5,
          "description": "Maximum number of author/review iterations before the loop fails closed if no design is approved."
        },
        "contextPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute filesystem paths granted to the design-authoring session as read-only live context references."
        },
        "modelProfile": {
          "type": "string",
          "default": "",
          "description": "Named model profile to select from the merged model policy."
        },
        "modelPolicy": {
          "type": "object",
          "default": {},
          "description": "Inline model policy document merged on top of the bundled and repository policies."
        },
        "modelPolicySource": {
          "type": "string",
          "default": "",
          "description": "Label recorded for the inline modelPolicy's provenance."
        },
        "modelPolicySha256": {
          "type": "string",
          "default": "",
          "description": "Expected canonical SHA-256 of the inline modelPolicy."
        },
        "modelsConfig": {
          "type": "string",
          "default": "",
          "description": "Relative path (inside the worktree) to the repository model policy file."
        },
        "modelOverrides": {
          "type": "object",
          "default": {},
          "description": "Per-role overrides merged on top of the selected profile's roles."
        }
      },
      "required": [
        "repoPath",
        "instruction",
        "callerWorkflow"
      ]
    }
  },
  "outputSchema": {
    "name": "design_docs_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "approved": {
          "type": "boolean",
          "description": "True once a design iteration was approved by human review or the design judge. On the not-approved path (stopped, or the iteration limit reached), the workflow either TERMINATEs FAILED with its own {approved:false, feedback} output (failClosed:true, the default) or completes normally with approved:false (failClosed:false)."
        },
        "stopped": {
          "type": "boolean",
          "description": "True when a human explicitly stopped the loop early (the 'stop' checkpoint action) rather than exhausting designMaxIterations without approval. Only reachable with humanApproval:true."
        },
        "reviewMode": {
          "type": "string",
          "enum": [
            "",
            "human",
            "agent"
          ],
          "description": "Which review path produced the last decision: 'human' (WAIT task) or 'agent' (design judge); empty only if the loop never ran an iteration."
        },
        "feedback": {
          "type": "string",
          "description": "Latest review feedback (human or judge) to fold into the next design iteration, or empty on first approval."
        },
        "iterations": {
          "type": "integer",
          "description": "Number of author/review iterations the design loop completed."
        },
        "filesChanged": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repository-relative design doc paths changed by the last design-authoring session."
        },
        "agent": {
          "type": "string",
          "description": "Backend that ran the last design-authoring session: claude, codex, or gemini."
        },
        "costUsd": {
          "type": "number",
          "description": "USD cost of the last design-authoring session."
        },
        "tokenUsed": {
          "type": "integer",
          "description": "Tokens consumed by the last design-authoring session."
        },
        "sessionId": {
          "type": "string",
          "description": "Backend session id of the last design-authoring session, usable as a resume id."
        },
        "designCommit": {
          "type": "string",
          "description": "Commit SHA of the approved design docs; empty string unless the design was approved and committed."
        },
        "finalMaxTurns": {
          "type": "integer",
          "description": "designMaxTurns, or a human-adjusted value from the last reviewed iteration. A caller that shares one budget/turn pool across multiple phases (e.g. feature_campaign) should carry this forward as its own next-phase starting point."
        },
        "finalMaxBudgetUsd": {
          "type": "number",
          "description": "designMaxBudgetUsd, or a human-adjusted value from the last reviewed iteration. Same carry-forward use as finalMaxTurns."
        },
        "promptTemplate": {
          "type": "object",
          "description": "Which design-phase prompt template source was requested vs. actually resolved for the last design-authoring session.",
          "properties": {
            "requestedSource": {
              "type": "string"
            },
            "resolvedSource": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "approved",
        "stopped",
        "reviewMode",
        "feedback",
        "iterations",
        "filesChanged",
        "agent",
        "costUsd",
        "tokenUsed",
        "sessionId",
        "designCommit",
        "finalMaxTurns",
        "finalMaxBudgetUsd",
        "promptTemplate"
      ]
    }
  },
  "enforceSchema": false
}
