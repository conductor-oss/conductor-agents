{
  "updateTime": 1784527270715,
  "name": "automation_reset",
  "description": "Explicitly clear a stopped or exhausted GitHub automation revision so a later sweep may claim it again.",
  "version": 1,
  "tasks": [
    {
      "name": "model_profile_resolve",
      "taskReferenceName": "model_policy",
      "type": "SIMPLE",
      "inputParameters": {
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}"
      }
    },
    {
      "name": "github_automation_state",
      "taskReferenceName": "reset",
      "inputParameters": {
        "attempt": 1,
        "kind": "${workflow.input.kind}",
        "number": "${workflow.input.number}",
        "repo": "${workflow.input.repo}",
        "revision": "${workflow.input.revision}",
        "status": "reset",
        "workflowId": "${workflow.workflowId}"
      },
      "type": "SIMPLE",
      "decisionCases": {},
      "defaultCase": []
    }
  ],
  "inputParameters": [
    "kind",
    "modelOverrides",
    "modelPolicy",
    "modelPolicySha256",
    "modelPolicySource",
    "modelProfile",
    "modelsConfig",
    "number",
    "repo",
    "revision"
  ],
  "outputParameters": {
    "reset": "${reset.output.recorded}"
  },
  "schemaVersion": 2,
  "restartable": true,
  "ownerEmail": "harness@conductor.local",
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0,
  "overwriteTags": false,
  "inputTemplate": {
    "modelProfile": "",
    "modelPolicy": {},
    "modelPolicySource": "",
    "modelPolicySha256": "",
    "modelsConfig": "",
    "modelOverrides": {}
  },
  "inputSchema": {
    "name": "automation_reset_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "'owner/name' GitHub repository slug the revision marker is recorded on."
        },
        "number": {
          "type": "integer",
          "description": "PR or issue number the automation revision applies to."
        },
        "kind": {
          "type": "string",
          "enum": [
            "review",
            "address",
            "issue"
          ],
          "description": "Automation kind whose revision is being reset."
        },
        "revision": {
          "type": "string",
          "description": "Revision fingerprint (head SHA or feedback fingerprint) being reset for reclaiming."
        },
        "modelProfile": {
          "type": "string",
          "default": "",
          "description": "Named model profile to select from the merged model policy."
        },
        "modelPolicy": {
          "type": "object",
          "default": {},
          "description": "Inline model policy document merged on top of the bundled and repository policies."
        },
        "modelPolicySource": {
          "type": "string",
          "default": "",
          "description": "Label recorded for the inline modelPolicy's provenance."
        },
        "modelPolicySha256": {
          "type": "string",
          "default": "",
          "description": "Expected canonical SHA-256 of the inline modelPolicy."
        },
        "modelsConfig": {
          "type": "string",
          "default": "",
          "description": "Relative path (inside the worktree) to the repository model policy file."
        },
        "modelOverrides": {
          "type": "object",
          "default": {},
          "description": "Per-role overrides merged on top of the selected profile's roles."
        }
      },
      "required": [
        "repo",
        "number",
        "kind",
        "revision"
      ]
    }
  },
  "outputSchema": {
    "name": "automation_reset_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "reset": {
          "type": "boolean",
          "description": "True once the 'reset' state marker comment recording this revision's clearance has been posted."
        }
      },
      "required": [
        "reset"
      ]
    }
  },
  "enforceSchema": false
}
