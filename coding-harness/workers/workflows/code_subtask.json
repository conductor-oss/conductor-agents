{
  "name": "code_subtask",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "viren@orkes.io",
  "description": "One parallel sub-task of code_parallel: create a git worktree/branch, run the coding_agent in it, and commit the changes on that branch so merge_worktrees can merge it back.",
  "timeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "inputParameters": [
    "allowedTools",
    "allowedWriteRoots",
    "maxBudgetUsd",
    "maxTurns",
    "model",
    "modelOverrides",
    "modelPolicy",
    "modelPolicySha256",
    "modelPolicySource",
    "modelProfile",
    "modelsConfig",
    "name",
    "prompt",
    "promptContext",
    "promptTemplate",
    "promptTemplateSource",
    "repoPath",
    "contextPaths",
    "specContextPath",
    "templateKey",
    "allowAgentTestPlan",
    "allowAgentAuthoredTests",
    "feedbackCorrelationId",
    "feedbackItem",
    "feedbackSince",
    "feedbackEveryTurns",
    "checkpointEveryTurns",
    "testCommands",
    "acceptanceTests",
    "outputSchema",
    "sandboxChecks",
    "modelTier"
  ],
  "inputSchema": {
    "name": "code_subtask_input",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "description": "Absolute path to the git repository this subtask creates a worktree/branch under."
        },
        "name": {
          "type": "string",
          "description": "Group name identifying this subtask; the worktree is created at .cc-worktrees/<name> on branch group/<name>."
        },
        "prompt": {
          "type": "string",
          "description": "Inline coding-agent prompt text for this subtask; used verbatim only if promptTemplate/templateKey resolve nothing."
        },
        "model": {
          "type": "string",
          "description": "Compatibility override: explicit model id for the coding agent's 'code' role sessions in this subtask."
        },
        "promptTemplate": {
          "type": "string",
          "default": "",
          "description": "Highest-precedence prompt source: inline template text, or '@relative/path' to read a template file from the worktree."
        },
        "promptTemplateSource": {
          "type": "string",
          "default": "",
          "description": "Caller-supplied label for which template source was requested; recorded in logs/output only."
        },
        "templateKey": {
          "type": "string",
          "default": "code",
          "description": "Template name used to look up a repo '.conductor/<key>.md' override or the bundled default prompt template."
        },
        "promptContext": {
          "type": "object",
          "default": {},
          "description": "Variables used to render the chosen prompt template."
        },
        "maxTurns": {
          "type": "integer",
          "default": 250,
          "description": "Cap on agent turns for the coding agent sessions in this subtask."
        },
        "maxBudgetUsd": {
          "type": "number",
          "default": 50,
          "description": "Cap on USD spend for the coding agent sessions in this subtask."
        },
        "modelProfile": {
          "type": "string",
          "default": "",
          "description": "Named model profile to resolve; empty string defers to the policy's default profile."
        },
        "modelPolicy": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "default": {},
          "description": "Inline model policy document (or JSON string) merged on top of the bundled and repository policies."
        },
        "modelPolicySource": {
          "type": "string",
          "default": "",
          "description": "Provenance label recorded for the inline modelPolicy."
        },
        "modelPolicySha256": {
          "type": "string",
          "default": "",
          "description": "Expected canonical SHA-256 of the inline modelPolicy."
        },
        "modelsConfig": {
          "type": "string",
          "default": "",
          "description": "Relative path (inside the worktree) to a repository model policy file, overriding the default location."
        },
        "modelOverrides": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "default": {},
          "description": "Per-role model overrides (or a JSON string of the same) merged on top of the selected profile."
        },
        "specContextPath": {
          "type": "string",
          "default": "",
          "description": "Single spec/context file path passed to the coding agent as read-only external context."
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Allow-list of tools the coding agent sessions may use in this subtask."
        },
        "allowedWriteRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Repository-relative path prefixes this subtask is authorized to write to; also used as the planned-paths set for delivery auditing (minus acceptanceTests)."
        },
        "acceptanceTests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "The item's frozen acceptance tests inside allowedWriteRoots: writable only so a wrong assertion can be amended, so the delivery audit never counts one left untouched as missing."
        },
        "contextPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute filesystem paths (files or directories) granted to the coding agent as read-only live context references."
        },
        "allowAgentTestPlan": {
          "type": "boolean",
          "default": true,
          "description": "Forwarded to this subtask's own test_cycle sub-workflow: when true and deterministic discovery is configuration_blocked, lets a coding agent search for and propose an existing test command as a last resort."
        },
        "allowAgentAuthoredTests": {
          "type": "boolean",
          "default": true,
          "description": "Forwarded to this subtask's own test_cycle sub-workflow: when true and allowAgentTestPlan's search also finds nothing, lets a coding agent author exactly one new test file, accepted only after a red/green check (fails against the pre-candidate baseline, passes against the real candidate change)."
        },
        "feedbackCorrelationId": {
          "type": "string",
          "description": "Board run id whose new directives the implementer session takes after each tool call (closure plan WP2). Empty disables."
        },
        "feedbackItem": {
          "type": "string",
          "description": "Work-item id whose directives are injected into the running session."
        },
        "feedbackSince": {
          "type": [
            "number",
            "string"
          ],
          "description": "Epoch seconds when the prompt was built; older directives are already in it."
        },
        "feedbackEveryTurns": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Poll the board every N tool calls (0 disables)."
        },
        "checkpointEveryTurns": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Snapshot the worktree every N tool calls (0 disables, H17)."
        },
        "testCommands": {
          "type": "array",
          "items": {},
          "description": "Explicit commands for this subtask's own test gate (e.g. its frozen acceptance tests, closure plan WP6); empty uses discovery."
        },
        "outputSchema": {
          "type": "object",
          "description": "Optional JSON schema for the implementer's structured end-of-session report (e.g. team lessons and constraint pushback, closure plan WP7/WP8). Empty means free text."
        },
        "sandboxChecks": {
          "type": "boolean",
          "default": false,
          "description": "Run the repository's check commands inside the OS sandbox (macOS sandbox-exec / Linux bwrap): writes confined to the disposable checkout and caches, no network except loopback (closure plan WP9, H17). A missing sandbox tool blocks the check as sandbox_unavailable."
        },
        "modelTier": {
          "type": [
            "integer",
            "string"
          ],
          "default": 0,
          "description": "Index into the code role's ordered model tiers (0 = first). A rescue dispatch of a stuck item runs a higher tier."
        }
      },
      "required": [
        "repoPath",
        "name"
      ]
    }
  },
  "outputSchema": {
    "name": "code_subtask_output",
    "type": "JSON",
    "data": {
      "type": "object",
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "passed",
            "audit_unavailable",
            "implementation_unavailable",
            "incomplete_delivery",
            null
          ],
          "description": "Overall delivery verdict for this subtask; null if the optional delivery_outcome step never ran."
        },
        "deliveryOutcome": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "passed",
            "audit_unavailable",
            "implementation_unavailable",
            "incomplete_delivery",
            null
          ],
          "description": "Same overall delivery verdict as status; null if the optional delivery_outcome step never ran."
        },
        "agentCompleted": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the coding agent reported completion; null if the optional delivery_outcome step never ran."
        },
        "agent": {
          "type": [
            "string",
            "null"
          ],
          "description": "Coding agent backend (claude, codex, or gemini) used for the last agent session; null if no agent session recorded output."
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model id actually used for the last agent session; null if no agent session recorded output."
        },
        "filesChanged": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Actual changed paths in the worktree, from the delivery audit; null if the optional delivery_outcome step never ran."
        },
        "stagedPaths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Paths staged and committed; null if the optional delivery_outcome step never ran."
        },
        "missingPaths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Planned paths that were never staged; null if the optional delivery_outcome step never ran."
        },
        "rejectedPaths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Changed paths rejected as non-vetted; null if the optional delivery_outcome step never ran."
        },
        "commandFailures": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Structured command failures observed during delivery; null if the optional delivery_outcome step never ran."
        },
        "sandboxDenials": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Sandbox denial messages observed during delivery; null if the optional delivery_outcome step never ran."
        },
        "repairAttempts": {
          "type": "integer",
          "description": "Number of delivery-repair loop iterations performed for this subtask (0 if the initial delivery audit already passed)."
        },
        "repairHistory": {
          "type": "object",
          "description": "Delivery-repair DO_WHILE loop output ({} if no repair loop ran).",
          "additionalProperties": true
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "description": "Total USD cost of the last recorded agent session; null if no agent session recorded output."
        },
        "tokenUsed": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Total tokens consumed by the last recorded agent session; null if no agent session recorded output."
        },
        "numTurns": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Total number of agent turns taken in the last recorded agent session; null if no agent session recorded output."
        },
        "turns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Per-turn log entries from the last recorded agent session; null if no agent session recorded output."
        },
        "branch": {
          "type": "string",
          "description": "Group branch checked out in the subtask's worktree."
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Resolved commit SHA for the subtask's changes; null if the optional delivery_outcome step never ran."
        },
        "testCycleState": {
          "type": [
            "string",
            "null"
          ],
          "description": "Terminal test_cycle state for this subtask's changes, or 'not_run'; null if the optional delivery_outcome step never ran."
        },
        "testsPassed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the subtask's test cycle passed; null if the optional delivery_outcome step never ran."
        },
        "testReport": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable summary from the subtask's test_cycle sub-workflow; null if that sub-workflow never produced output."
        },
        "feedbackInjections": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Directives injected into the implementer session while it worked."
        },
        "interruptedBy": {
          "type": [
            "object",
            "null"
          ],
          "description": "Blocking directive that stopped the session, or null."
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Worktree snapshots taken during the session."
        },
        "restoredCheckpoint": {
          "type": [
            "object",
            "null"
          ],
          "description": "Checkpoint restored at session start, or null."
        },
        "structured": {
          "type": [
            "object",
            "null"
          ],
          "description": "The implementer's structured report when outputSchema was given."
        }
      },
      "required": [
        "status",
        "deliveryOutcome",
        "agentCompleted",
        "agent",
        "model",
        "filesChanged",
        "stagedPaths",
        "missingPaths",
        "rejectedPaths",
        "commandFailures",
        "sandboxDenials",
        "repairAttempts",
        "repairHistory",
        "costUsd",
        "tokenUsed",
        "numTurns",
        "turns",
        "branch",
        "commit",
        "testCycleState",
        "testsPassed",
        "testReport"
      ]
    }
  },
  "inputTemplate": {
    "promptTemplate": "",
    "promptTemplateSource": "",
    "templateKey": "code",
    "promptContext": {},
    "maxTurns": 250,
    "maxBudgetUsd": 50,
    "modelProfile": "",
    "modelPolicy": {},
    "modelPolicySource": "",
    "modelPolicySha256": "",
    "modelsConfig": "",
    "modelOverrides": {},
    "specContextPath": "",
    "allowedTools": [],
    "allowedWriteRoots": [],
    "contextPaths": [],
    "allowAgentTestPlan": true,
    "allowAgentAuthoredTests": true,
    "feedbackCorrelationId": "",
    "feedbackItem": "",
    "feedbackSince": 0,
    "feedbackEveryTurns": 1,
    "checkpointEveryTurns": 0,
    "testCommands": [],
    "acceptanceTests": [],
    "outputSchema": {},
    "sandboxChecks": false,
    "modelTier": 0
  },
  "variables": {
    "deliveryState": "pending",
    "lastAudit": {},
    "lastAgentReport": {},
    "repairAttempts": 0,
    "repairHistory": {}
  },
  "tasks": [
    {
      "name": "model_profile_resolve",
      "taskReferenceName": "model_policy",
      "type": "SIMPLE",
      "inputParameters": {
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "repoPath": "${workflow.input.repoPath}"
      }
    },
    {
      "name": "worktree_add",
      "taskReferenceName": "wt",
      "type": "SIMPLE",
      "inputParameters": {
        "repoPath": "${workflow.input.repoPath}",
        "name": "${workflow.input.name}"
      }
    },
    {
      "name": "coding_agent",
      "taskReferenceName": "code",
      "type": "SIMPLE",
      "optional": true,
      "inputParameters": {
        "worktreePath": "${wt.output.worktreePath}",
        "contextFiles": [
          "${workflow.input.specContextPath}"
        ],
        "contextPaths": "${workflow.input.contextPaths}",
        "prompt": "${workflow.input.prompt}",
        "promptTemplate": "${workflow.input.promptTemplate}",
        "promptTemplateSource": "${workflow.input.promptTemplateSource}",
        "templateKey": "${workflow.input.templateKey}",
        "promptContext": "${workflow.input.promptContext}",
        "model": "${workflow.input.model}",
        "maxTurns": "${workflow.input.maxTurns}",
        "maxBudgetUsd": "${workflow.input.maxBudgetUsd}",
        "allowedTools": "${workflow.input.allowedTools}",
        "allowedWriteRoots": "${workflow.input.allowedWriteRoots}",
        "modelRole": "code",
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "modelResolution": "${model_policy.output}",
        "failSoft": true,
        "feedbackCorrelationId": "${workflow.input.feedbackCorrelationId}",
        "feedbackItem": "${workflow.input.feedbackItem}",
        "feedbackSince": "${workflow.input.feedbackSince}",
        "feedbackEveryTurns": "${workflow.input.feedbackEveryTurns}",
        "checkpointEveryTurns": "${workflow.input.checkpointEveryTurns}",
        "schema": "${workflow.input.outputSchema}",
        "modelTier": "${workflow.input.modelTier}"
      }
    },
    {
      "name": "delivery_audit",
      "taskReferenceName": "initial_delivery_audit",
      "type": "SIMPLE",
      "inputParameters": {
        "repoPath": "${wt.output.worktreePath}",
        "plannedPaths": "${workflow.input.allowedWriteRoots}",
        "optionalPaths": "${workflow.input.acceptanceTests}",
        "agentReport": "${code.output}"
      }
    },
    {
      "name": "record_initial_delivery",
      "taskReferenceName": "record_initial_delivery",
      "type": "SET_VARIABLE",
      "inputParameters": {
        "deliveryState": "${initial_delivery_audit.output.state}",
        "lastAudit": "${initial_delivery_audit.output}",
        "lastAgentReport": "${code.output}"
      }
    },
    {
      "name": "delivery_repair_gate",
      "taskReferenceName": "delivery_repair_gate",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "state",
      "inputParameters": {
        "state": "${workflow.variables.deliveryState}"
      },
      "decisionCases": {
        "passed": [
          {
            "name": "skip_delivery_repairs",
            "taskReferenceName": "skip_delivery_repairs",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "repairAttempts": 0,
              "repairHistory": {}
            }
          }
        ],
        "interrupted": [
          {
            "name": "skip_delivery_repairs",
            "taskReferenceName": "skip_delivery_repairs_interrupted",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "repairAttempts": 0,
              "repairHistory": {}
            }
          }
        ],
        "pushback": [
          {
            "name": "skip_delivery_repairs",
            "taskReferenceName": "skip_delivery_repairs_pushback",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "repairAttempts": 0,
              "repairHistory": {}
            }
          }
        ],
        "satisfied": [
          {
            "name": "skip_delivery_repairs",
            "taskReferenceName": "skip_delivery_repairs_satisfied",
            "type": "SET_VARIABLE",
            "inputParameters": {
              "repairAttempts": 0,
              "repairHistory": {}
            }
          }
        ]
      },
      "defaultCase": [
        {
          "name": "delivery_repair_loop",
          "taskReferenceName": "delivery_repair_loop",
          "type": "DO_WHILE",
          "evaluatorType": "graaljs",
          "loopCondition": "(function(){ return $.delivery_repair_loop['iteration'] < 3 && $.deliveryState !== 'passed'; })();",
          "inputParameters": {
            "delivery_repair_loop": "${delivery_repair_loop.output}",
            "deliveryState": "${workflow.variables.deliveryState}"
          },
          "loopOver": [
            {
              "name": "json_text",
              "taskReferenceName": "delivery_repair_context",
              "type": "SIMPLE",
              "inputParameters": {
                "missingPaths": "${workflow.variables.lastAudit.missingPaths}",
                "rejectedPaths": "${workflow.variables.lastAudit.rejectedPaths}",
                "commandFailures": "${workflow.variables.lastAudit.commandFailures}",
                "sandboxDenials": "${workflow.variables.lastAudit.sandboxDenials}",
                "previousStructuredReport": "${workflow.variables.lastAgentReport.structured}"
              },
              "optional": true
            },
            {
              "name": "coding_agent",
              "taskReferenceName": "delivery_repair",
              "type": "SIMPLE",
              "optional": true,
              "inputParameters": {
                "worktreePath": "${wt.output.worktreePath}",
                "contextFiles": [
                  "${workflow.input.specContextPath}"
                ],
                "contextPaths": "${workflow.input.contextPaths}",
                "prompt": "This delivery is INCOMPLETE. These planned paths do not exist in the worktree and MUST be created, with real content, before anything else counts: ${delivery_repair_context.output.missingPathsJson}\nRejected paths (correct them without fabricating replacements): ${delivery_repair_context.output.rejectedPathsJson}\nCommand failures: ${delivery_repair_context.output.commandFailuresJson}\nSandbox denials: ${delivery_repair_context.output.sandboxDenialsJson}\n\nRepair only this incomplete delivery, within the authorized tools. Do not infer success from the prior prose report; do not stop because the files that already exist look complete, or because tests outside this subtask fail: the delivery is complete only when every missing path above exists.\n\nSubtask: ${workflow.input.prompt}\n\nPrevious structured agent report: ${delivery_repair_context.output.previousStructuredReportJson}\nPrevious status: ${workflow.variables.lastAgentReport.status}\nPrevious error: ${workflow.variables.lastAgentReport.error}",
                "promptTemplate": "",
                "promptTemplateSource": "${workflow.input.promptTemplateSource}",
                "templateKey": "delivery_repair",
                "promptContext": {
                  "missingPathsJson": "${delivery_repair_context.output.missingPathsJson}",
                  "rejectedPathsJson": "${delivery_repair_context.output.rejectedPathsJson}",
                  "commandFailuresJson": "${delivery_repair_context.output.commandFailuresJson}",
                  "sandboxDenialsJson": "${delivery_repair_context.output.sandboxDenialsJson}",
                  "prompt": "${workflow.input.prompt}",
                  "previousStructuredReportJson": "${delivery_repair_context.output.previousStructuredReportJson}",
                  "status": "${workflow.variables.lastAgentReport.status}",
                  "error": "${workflow.variables.lastAgentReport.error}"
                },
                "model": "${workflow.input.model}",
                "maxTurns": "${workflow.input.maxTurns}",
                "maxBudgetUsd": "${workflow.input.maxBudgetUsd}",
                "allowedTools": "${workflow.input.allowedTools}",
                "allowedWriteRoots": "${workflow.input.allowedWriteRoots}",
                "modelRole": "code",
                "modelProfile": "${workflow.input.modelProfile}",
                "modelPolicy": "${workflow.input.modelPolicy}",
                "modelPolicySource": "${workflow.input.modelPolicySource}",
                "modelPolicySha256": "${workflow.input.modelPolicySha256}",
                "modelsConfig": "${workflow.input.modelsConfig}",
                "modelOverrides": "${workflow.input.modelOverrides}",
                "modelResolution": "${model_policy.output}",
                "failSoft": true,
                "modelTier": "${workflow.input.modelTier}"
              }
            },
            {
              "name": "delivery_audit",
              "taskReferenceName": "repair_delivery_audit",
              "type": "SIMPLE",
              "inputParameters": {
                "repoPath": "${wt.output.worktreePath}",
                "plannedPaths": "${workflow.input.allowedWriteRoots}",
                "optionalPaths": "${workflow.input.acceptanceTests}",
                "agentReport": "${delivery_repair.output}"
              }
            },
            {
              "name": "record_delivery_repair",
              "taskReferenceName": "record_delivery_repair",
              "type": "SET_VARIABLE",
              "inputParameters": {
                "deliveryState": "${repair_delivery_audit.output.state}",
                "lastAudit": "${repair_delivery_audit.output}",
                "lastAgentReport": "${delivery_repair.output}"
              }
            }
          ]
        },
        {
          "name": "capture_delivery_repair_history",
          "taskReferenceName": "capture_delivery_repair_history",
          "type": "SET_VARIABLE",
          "inputParameters": {
            "repairAttempts": "${delivery_repair_loop.output.iteration}",
            "repairHistory": "${delivery_repair_loop.output}"
          }
        }
      ]
    },
    {
      "name": "commit",
      "taskReferenceName": "cmt",
      "type": "SIMPLE",
      "optional": true,
      "inputParameters": {
        "repoPath": "${wt.output.worktreePath}",
        "message": "code_subtask ${workflow.input.name}",
        "allowedWriteRoots": "${workflow.input.allowedWriteRoots}",
        "acceptanceTests": "${workflow.input.acceptanceTests}"
      }
    },
    {
      "name": "test_cycle",
      "taskReferenceName": "subtask_tests",
      "type": "SUB_WORKFLOW",
      "optional": true,
      "subWorkflowParam": {
        "name": "test_cycle"
      },
      "inputParameters": {
        "repoPath": "${wt.output.worktreePath}",
        "candidateCommit": "${cmt.output.commit}",
        "testMode": "targeted",
        "allowAgentTestPlan": "${workflow.input.allowAgentTestPlan}",
        "allowAgentAuthoredTests": "${workflow.input.allowAgentAuthoredTests}",
        "maxFixAttempts": 1,
        "allowedWriteRoots": "${workflow.input.allowedWriteRoots}",
        "model": "${workflow.input.model}",
        "maxTurns": "${workflow.input.maxTurns}",
        "maxBudgetUsd": "${workflow.input.maxBudgetUsd}",
        "repairPromptTemplate": "${workflow.input.promptTemplate}",
        "repairPromptTemplateSource": "${workflow.input.promptTemplateSource}",
        "modelProfile": "${workflow.input.modelProfile}",
        "modelPolicy": "${workflow.input.modelPolicy}",
        "modelPolicySource": "${workflow.input.modelPolicySource}",
        "modelPolicySha256": "${workflow.input.modelPolicySha256}",
        "modelsConfig": "${workflow.input.modelsConfig}",
        "modelOverrides": "${workflow.input.modelOverrides}",
        "testCommands": "${workflow.input.testCommands}",
        "sandboxChecks": "${workflow.input.sandboxChecks}"
      }
    },
    {
      "name": "code_subtask_delivery_outcome",
      "taskReferenceName": "delivery_outcome",
      "type": "SIMPLE",
      "optional": true,
      "inputParameters": {
        "plannedPaths": "${workflow.input.allowedWriteRoots}",
        "optionalPaths": "${workflow.input.acceptanceTests}",
        "commit": "${cmt.output}",
        "audit": "${workflow.variables.lastAudit}",
        "agent": "${workflow.variables.lastAgentReport}",
        "tested": "${subtask_tests.output.candidateCommit}",
        "testState": "${subtask_tests.output.testCycleState}",
        "testsPassed": "${subtask_tests.output.testsPassed}"
      }
    }
  ],
  "outputParameters": {
    "status": "${delivery_outcome.output.state}",
    "deliveryOutcome": "${delivery_outcome.output.state}",
    "agentCompleted": "${delivery_outcome.output.agentCompleted}",
    "agent": "${workflow.variables.lastAgentReport.agent}",
    "model": "${workflow.variables.lastAgentReport.model}",
    "filesChanged": "${delivery_outcome.output.actualPaths}",
    "stagedPaths": "${delivery_outcome.output.stagedPaths}",
    "missingPaths": "${delivery_outcome.output.missingPaths}",
    "rejectedPaths": "${delivery_outcome.output.rejectedPaths}",
    "commandFailures": "${delivery_outcome.output.commandFailures}",
    "sandboxDenials": "${delivery_outcome.output.sandboxDenials}",
    "repairAttempts": "${workflow.variables.repairAttempts}",
    "repairHistory": "${workflow.variables.repairHistory}",
    "costUsd": "${workflow.variables.lastAgentReport.costUsd}",
    "tokenUsed": "${workflow.variables.lastAgentReport.tokenUsed}",
    "numTurns": "${workflow.variables.lastAgentReport.numTurns}",
    "turns": "${workflow.variables.lastAgentReport.turns}",
    "branch": "${wt.output.branch}",
    "commit": "${delivery_outcome.output.commit}",
    "testCycleState": "${delivery_outcome.output.testCycleState}",
    "testsPassed": "${delivery_outcome.output.testsPassed}",
    "testReport": "${subtask_tests.output.testReport}",
    "feedbackInjections": "${code.output.feedbackInjections}",
    "interruptedBy": "${code.output.interruptedBy}",
    "checkpoints": "${code.output.checkpoints}",
    "restoredCheckpoint": "${code.output.restoredCheckpoint}",
    "deniedWrites": "${workflow.variables.lastAgentReport.deniedWrites}",
    "outsideScope": "${cmt.output.outsideScope}",
    "structured": "${code.output.structured}"
  },
  "enforceSchema": false
}
